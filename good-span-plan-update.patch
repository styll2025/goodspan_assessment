in-width:0;max-width:none;font-size:13px;line-height:1.5}\n.road .srcs li::before,.road.vroad .srcs li::before{display:none!important;content:none}\n.road.vroad li.js .jref{grid-column:1/-1!important}\n.srcs a{color:inherit;word-break:normal!important;overflow-wrap:anywhere}\n<\/style>\n\n<div class=\"shell\">\n  <header class=\"top\">\n    <img src=\"data:image/png;base64,\" alt=\"The Good Span\">\n    <div class=\"who\" role=\"group\" aria-label=\"Member\" id=\"who\"><\/div>\n  <\/header>\n  <div class=\"steps\" id=\"steps\" aria-live=\"polite\"><\/div>\n  <main id=\"screens\"><\/main>\n<\/div>\n\n<script>\nconst D = __DATA__;\n// generated from a member's own answers (the conversation): the hand-written copy below is not used\nconst GEN = D.some(r => r.gen);\n// practices taken out of a member's line-up after review (no clear link to their answers)\nconst DROP = { Hugo: ['Daily eating window'] };\n// month 1 is at most three practices, not a target; each must trace back to an answer. Later months stay within the time limit.\nconst PLAN = {\n  'Maria': { keep: ['Weekly cardio'], m2: ['Walking after meals'], m3: ['Balance'], later: [] },\n  'Marta': { keep: ['Reframing', 'Savouring'], m2: ['Self-compassion'], m3: ['Weekly cardio'], later: ['Problem-solving steps', 'Walking after meals', 'Stretching'] },\n  'Hugo': { keep: ['Enough sleep', 'Balanced plate'], m2: ['Slow breathing to wind down', 'Beans and lentils'], m3: ['Bedtime to-do list'], later: [], refs: { 'Balanced plate': /Aune/ } }\n};\n// extra minutes a week each later practice adds (Balance counted at its 11-minute start)\nconst STEPMIN = { 'Walking after meals': 50, 'Balance': 33, 'Self-compassion': 15, 'Weekly cardio': 30, 'Problem-solving steps': 10, 'Stretching': 30, 'Slow breathing to wind down': 25, 'Bedtime to-do list': 35, 'Beans and lentils': 0 };\nconst STEPNAME = { 'Weekly cardio': 'Aerobic activity' };\nD.forEach(r => { if (r.gen || r.planned) return; const d = DROP[r.name] || []; for (const a in r.lineup) r.lineup[a] = r.lineup[a].filter(x => !d.includes(x.fam)); r.later = r.later.filter(x => !d.includes(x.fam)); });\nD.forEach(r => { const pl = PLAN[r.name]; if (!pl || r.gen || r.planned) return; const pool = [...r.practices, ...Object.values(r.lineup).flat(), ...r.later]; const get = f => ({ ...pool.find(x => x.fam === f) });\n  r.practices = pl.keep.map(get); r.practices.forEach(x => { const re = (pl.refs || {})[x.fam]; if (re) x.refs = (x.refs || []).filter(t => re.test(t)); });\n  r.steps = { m2: pl.m2.map(get), m3: pl.m3.map(get), later: pl.later.map(get) }; r.add2 = pl.m2; r.add3 = pl.m3; });\nconst AREAS = ['Nutrition', 'Sleep', 'Movement', 'Mind', 'Connection', 'Prevention'];\nconst STEPS = ['Your Starting Position', 'Your Starting Position', 'Where your effort will count most', 'Your first practices', 'Designed to fit your life', 'Your six-month Good Span', 'Ready to start'];\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst low = s => s ? s.charAt(0).toLowerCase() + s.slice(1) : s;\nconst list = a => a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];\nlet who = 0, step = 0;\n\n// one circle per pillar: filled = focus now, dotted outline = worth improving, solid outline = going well\nfunction circle(area, g) {\n  const fill = { Nutrition: '#FE600C', Sleep: '#FFF2EA', Movement: '#F5A4C2', Mind: '#CB863A', Connection: '#4D2831', Prevention: '#000000' }[area];\n  if (g === 'focus') return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"${fill}\" stroke=\"#4D2831\" stroke-width=\"1.5\"/><circle cx=\"60\" cy=\"60\" r=\"34\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1\" stroke-dasharray=\"2 5\"/><\/svg>`;\n  if (g === 'improve') return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.5\" stroke-dasharray=\"1.5 6\" stroke-linecap=\"round\"/><\/svg>`;\n  return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.5\"/><\/svg>`;\n}\n// open line arcs from the identity's graphic language: solid, dashed and dotted, no more than three styles\nconst ARC = (cfg) => `<div class=\"arcs\" aria-hidden=\"true\">${cfg.map(([x, y, r, col, style, w]) => `<svg style=\"left:${x};top:${y};width:${r * 2}px;height:${r * 2}px;transform:translate(-50%,-50%)\" viewBox=\"0 0 ${r * 2} ${r * 2}\"><circle cx=\"${r}\" cy=\"${r}\" r=\"${r - 2}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"${w || 1.5}\" ${style === 'dash' ? 'stroke-dasharray=\"10 8\"' : style === 'dot' ? 'stroke-dasharray=\"1 7\" stroke-linecap=\"round\"' : ''}/><\/svg>`).join('')}<\/div>`;\n// the opening: within ten seconds the member should feel understood, see that it's manageable, and know where it starts.\n// The reasoning (time, pace, method) comes later, in the Starting Position and \"Designed to fit your life\".\nconst OPEN = {\n  'Maria': { lead: \"Maria, you're already doing a lot right.\", paras: ['Your answers show strong foundations across much of your everyday life. Rather than giving you more things to do, we think the best place to start is a little more aerobic movement, and a few more vegetables and fruit.'], starts: ['One practice', 'Movement', 'about 30 minutes a week'] },\n  'Marta': { lead: 'Marta, your Good Span starts with what matters most to you: feeling better day to day.', paras: ['You already have strong foundations in sleep, nutrition and connection. But you told us that stress and difficult emotions have been taking up more space recently.', \"You also told us meditation and journalling aren't for you, so your starting practices don't rely on either.\"], starts: ['Two practices', 'Mind first', 'about 15 minutes a week'] },\n  'Hugo': { lead: 'Hugo, you told us you want to improve your fitness. One thing comes first.', paras: [\"Because you mentioned chest discomfort during exercise, we'd hold off on increasing your activity until you've discussed it with a doctor.\", \"That doesn't mean your Good Span has to wait.\", 'Your answers point to sleep and nutrition as useful places to start now.'], starts: ['Two practices', 'Sleep and Nutrition', 'no extra time set aside'] }\n};\nconst openingOf = r => r.opening || OPEN[r.name] || { lead: r.name + ', here’s where we’d start.', paras: [], starts: [] };\n// (earlier opening portrait, kept for reference; no longer shown)\nconst INTRO1 = {\n  'Maria': 'You have already built some good habits across your everyday life. Movement is the area where a little more consistency could make the biggest difference to your next steps.',\n  'Marta': \"You told us you'd like support with your mental wellbeing, especially managing stress and difficult emotions. That's where your Good Span starts. A little more movement can follow from month 3, since you're already close to the guideline.\",\n  'Hugo': [\"You told us you'd like to move more and build your fitness. Before we suggest any increase in activity, there's one important thing to discuss with a doctor first, explained just below.\", 'In the meantime, your answers point to sleep and nutrition, where focusing now could make a real difference while movement waits.']\n};\nfunction intro(r) {\n  const n = r.practices.length, num = ['', 'one practice', 'two practices', 'three practices'][n];\n  const p1 = [].concat(INTRO1[r.name] || `${list(r.focus)} ${r.focus.length > 1 ? 'are the areas' : 'is the area'} where your effort could make the biggest difference.`);\n  const pace = { 'Something in between': \"you're looking for a pace that feels steady without being too gentle\", 'Small, easy steps': \"you'd like to start with small, easy steps\", 'A bigger challenge': \"you've asked for a bigger challenge\" }[r.pace] || \"you'd like a pace that suits you\";\n  const p2 = `You have around ${r.timeTxt} a week to dedicate to your wellbeing, and ${pace}. We've used your answers to shape your Good Span around what you already do, where you could make progress, and what feels realistic for your life.`;\n  const p3 = `Your Good Span starts with ${num}. Small enough to begin, meaningful enough to build on.`;\n  return [...p1, p2, p3];\n}\n\n// Starting Position: one specific observation per dimension, from each member's own answers\nconst SPC = {\n  'Maria': {\n    Movement: ['Your focus', \"You're active three days a week, about 120 minutes in all, with strength training twice a week.\"],\n    Nutrition: ['Your focus', 'You cook 3 to 5 main meals a week at home and already eat 3–4 portions of vegetables and fruit a day.'],\n    Sleep: ['Well supported', 'You sleep 7–8 hours, keep a regular bedtime and wake time, and your bedroom is cool, dark and quiet.'],\n    Mind: ['Habits to protect', 'You spend 2–3 hours a week in nature and make time for things you enjoy, away from work.'],\n    Connection: ['Staying connected', 'You see friends or family every week and take part in a group or class 2–3 times a month.'],\n    Prevention: ['Positive foundations', \"You don't smoke, keep alcohol to 1–2 drinks a few times a month and had your blood pressure checked in the past year.\"]\n  },\n  'Marta': {\n    Mind: ['Your focus', \"You'd like support with managing stress and difficult emotions, and you already make time for hobbies and time in nature.\"],\n    Movement: ['Your focus', \"You're active three days a week, about 120 minutes in all, with strength training twice a week.\"],\n    Nutrition: ['Eating well', 'You eat 3–4 portions of vegetables and fruit a day, with protein in two of your main meals.'],\n    Sleep: ['Well supported', 'You sleep 7–8 hours, get morning daylight and finish your caffeine by early afternoon.'],\n    Connection: ['Staying connected', 'You share meals with others most weeks and take time to really listen when you talk.'],\n    Prevention: ['Positive foundations', \"You don't smoke, keep alcohol to a few drinks a month and had your blood pressure checked in the past year.\"]\n  },\n  'Hugo': {\n    Sleep: ['Your focus', 'You usually sleep 6–7 hours, and on several nights a week it takes you a long time to fall asleep.'],\n    Nutrition: ['Your focus', 'You cook most of your meals at home, but usually eat around 1–2 portions of vegetables and fruit a day.'],\n    Movement: ['On hold for now', \"You'd like to improve your fitness. Because of the chest discomfort you mentioned, increasing your activity waits until you've spoken to a doctor.\"],\n    Mind: ['Habits to protect', 'You spend 2–3 hours a week in nature and keep social media to under an hour a day.'],\n    Connection: ['Staying connected', 'You see friends or family every week and take part in a group or class 2–3 times a month.'],\n    Prevention: ['Positive foundations', \"You don't smoke, and your blood pressure was checked in the past year.\"]\n  }\n};\n\n// photo of the member's first focus area, from the website's pillar images\nconst IMG = __IMG__;\nconst NOTICE = { Marta: { title: 'Something worth discussing', text: \"You told us you've felt anxious or low on most days over the last two weeks. The practices in your Good Span can support you day to day, but they aren't a treatment. When feelings like these last, it's worth talking to your GP or another health professional, alongside your Good Span.\" } };\n// photo chosen per member where it differs from the first focus area\nconst PHOTO = { Hugo: 'Stretch' };\nconst ALT = { Nutrition: 'Hands stirring a steaming pot of rice.', Sleep: 'A woman laughing as she reads on cushions by a sunny window.', Movement: 'A small group doing yoga together on the grass in a Lisbon park.', Mind: 'A textile artist smiling as she stitches red thread at her table.', Connection: 'Two women of different generations walking arm in arm at golden hour, smiling at each other.', Prevention: 'A hand brushing through herbs in a rooftop garden.', Stretch: 'A woman stretching forward on a green mat in warm morning light.' };\n// section 3: why each focus, explained once; what already goes well in it\nconst MOVE = { p: [\"You already move regularly and include strength training in your week. Your answers suggest that building up your aerobic activity is a practical next step.\", \"You're currently doing around 120 minutes of moderate activity a week. The general guideline is at least 150 minutes, so you're already close. A little more movement could help you build towards that benchmark over time.\"], well: ['Getting 8,000–10,000 steps on a typical day.', 'Making time for strength training twice a week.', 'Staying active outdoors and at home.'] };\nconst FOC = {\n  'Maria': { Movement: MOVE, Nutrition: { p: ['You already cook most of your meals at home and include protein in two of them. The clearest next step is a few more vegetables and fruit.', 'You eat around 3–4 portions a day. The general guideline is at least 5, so one more portion a day would get you there.'], well: ['Cooking 3 to 5 main meals a week at home.', 'Including protein in two of your main meals.', 'Eating whole grains on most days.'] } },\n  'Marta': {\n    Mind: { p: [\"You'd like support with managing stress and difficult emotions, and you already make time for things you enjoy.\", \"Over the last two weeks, you've often felt anxious or low. Your Good Span starts with two small, everyday practices that build on what you already enjoy, and support you day to day.\"], well: ['Making time for hobbies and activities you enjoy.', 'Taking time away from work.', 'Spending 2–3 hours a week in nature.'] },\n    Movement: { p: [MOVE.p[0], \"You're currently doing around 120 minutes of moderate activity a week, close to the 150-minute guideline. Because your priority is your mental wellbeing, this joins your Good Span in month 3, once your first practices feel settled.\"], well: MOVE.well }\n  },\n  'Hugo': {\n    Sleep: { p: ['You already have a regular routine and a bedroom set up for sleep. What your answers point to is the time you give sleep, and how easily you fall asleep.', 'You usually sleep 6–7 hours a night, and on 3 or more nights a week it takes you a long time to fall asleep. The general guideline is 7 or more hours for adults.'], well: ['Getting daylight in the morning.', 'Keeping a regular bedtime and wake time.', 'Keeping your bedroom cool, dark and quiet.'] },\n    Nutrition: { p: ['You cook most of your meals at home and already include protein and whole grains. The gap is vegetables and fruit.', \"You're currently eating around 1–2 portions a day. The general guideline is at least 5, so a little more each day could help you build towards that over time.\"], well: ['Cooking 3 to 5 main meals a week at home.', 'Including protein in two of your main meals.', 'Keeping sugary drinks, processed foods and added salt occasional.'] }\n  }\n};\n\n// sections 4–7: practice cards are action-first. 'min' is the extra time each one adds, and section 6 adds these up.\nconst NUMW = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];\nconst AEROBIC = { t: 'Build your aerobic activity', a: 'Add about 30 minutes of moderate activity to your week.', min: 30, time: 'About 30 minutes a week, on top of the 120 you already do. That brings you to the 150-minute guideline.', make: ['For example, a 10-minute brisk walk on three days, or a few extra minutes in sessions you already do.', 'Use the talk test to gauge intensity: you should be breathing more heavily while still being able to talk.'], why: 'The World Health Organization recommends at least 150 minutes of moderate activity a week for adults, based on its links with heart health and long-term wellbeing.' };\nconst PRC = {\n  'Maria': [AEROBIC],\n  'Marta': [\n    { t: 'Look at it another way', a: 'Once a week, look at an upsetting moment from a different angle.', min: 5, tl: '5 min a week (once a week)', time: 'About 5 minutes, once a week.', make: [\"When something upsetting happens and you've settled a little, ask yourself what is within your control right now, and what other ways you could see it.\", 'You can do this in your head, on a walk or while listening to music, whichever suits you.'], why: 'A large review of studies found that changing how you think about a situation helped people manage how they felt in the moment, more than trying to push feelings away.' },\n    { t: 'Savour the good moments', a: 'Once a day, pause to savour a pleasant moment as it happens.', min: 10, tl: 'about 10 min a week (1–2 min a day)', time: '1–2 minutes a day, about 10 minutes a week.', make: ['When something enjoyable happens, like a good cup of tea, a favourite song or sunshine on your face, slow down, notice the details and let yourself enjoy it a little longer.', 'It fits easily into the quiet time you already like to have on your own.'], why: 'A review of trials found that savouring exercises increased positive emotions and wellbeing. It builds on time you already make for things you enjoy.' }],\n  'Hugo': [\n    { t: 'Protect your sleep window', a: 'Allow 7 hours or more for sleep on at least 6 nights a week.', min: 0, time: 'No extra activity time. It may mean going to bed a little earlier.', make: ['Work back from the time you need to get up, and set a time to start winding down.', 'Keep a simple sleep diary, or use a wearable, and notice how rested you feel during the day.'], why: 'You usually sleep 6–7 hours. Sleep experts recommend 7 or more hours a night for adults, and you already keep a regular bedtime and wake time, so this adjusts a routine you have.' },\n    { t: 'More vegetables and fruit', a: 'Add vegetables or fruit to one more meal every day.', min: 0, time: 'No extra time: it changes what goes into meals you already cook.', make: ['Start with one extra portion. Once that feels normal, add another.', 'You enjoy cooking, so this can be a chance to try a new vegetable or recipe each week.'], why: 'You eat around 1–2 portions of vegetables and fruit a day, and 5 is the general guideline. Large reviews link eating more of them with a lower risk of heart disease.' }]\n};\nconst pmins = r => (PRC[r.name] || []).reduce((t, c) => t + (c.min || 0), 0) || r.mins;\n// designed to fit your life: one compact block under the practices\nfunction fitBlock(r) {\n  const n = r.practices.length, cap = { 45: '45 minutes', 60: 'one hour', 120: 'two hours', 240: 'four hours' }[r.lower] || r.lower + ' minutes';\n  const pace = { 'Something in between': 'steady pace', 'Small, easy steps': 'small, easy steps', 'A bigger challenge': r.safety ? 'a bigger challenge, once it is safe' : 'a bigger challenge' }[r.pace] || 'your pace';\n  const m = pmins(r);\n  const rows = (PRC[r.name] || []).length ? PRC[r.name].map(c => [c.t, c.tl || (c.min ? c.min + ' min a week' : 'No extra time')]) : r.practices.map(x => [x.fam, x.min ? x.min + ' min a week' : 'No extra time']);\n  return `<div class=\"fitb\"><h3>Designed to fit your life<\/h3>\n    <div class=\"fstats\"><div><b>${m ? m + ' min' : 'No extra time'}<\/b><span>${m ? 'a week to start' : 'to start'}<\/span><\/div><div><b>${esc(cap1(pace))}<\/b><span>the pace you asked for<\/span><\/div><div><b>${cap1(NUMW[n])} practice${n === 1 ? '' : 's'}<\/b><span>to begin with<\/span><\/div><\/div>\n    ${rows.length > 1 ? `<ul class=\"tbr\">${rows.map(([t, v]) => `<li><span>${esc(t)}<\/span><b>${esc(v)}<\/b><\/li>`).join('')}<\/ul>` : ''}\n    <ul class=\"fit3\"><li><b>Your time, respected<\/b><span>We plan for no more than ${cap} a week, the lower end of what you told us you have.<\/span><\/li><li><b>Built around what you already do<\/b><span>Nothing asks you to do more of what is already going well.<\/span><\/li><li><b>Adapted as you progress<\/b><span>New practices join one at a time, and we adjust or swap them to keep within your time.<\/span><\/li><\/ul><\/div>`;\n}\n// recommended = flagged by the plan (older records: the first two)\nconst isRec = (r, x, i) => x.rec !== undefined ? !!x.rec : i < 2;\nconst cap1 = t => t ? t.charAt(0).toUpperCase() + t.slice(1) : t;\n// next steps: the same names and months in the journey\nconst whenOf = (r, fam) => r.add2.includes(fam) ? 'Month 2' : r.add3.includes(fam) ? 'Month 3' : 'Months 4–5';\n\nconst NXT = {\n  'Walking after meals': 'Add a 10-minute walk after one of your main meals, five days a week. A simple way to bring more movement into the day.',\n  'Balance': 'Introduce balance-challenging exercises three times a week, starting with about 11 minutes. Build this into your routine as you feel ready.',\n  'Weekly cardio': 'Add about 30 minutes of moderate activity a week, bringing you to the 150-minute guideline. You are already close.',\n  'Self-compassion': 'Take a short self-compassion break when something feels hard, for about 5 minutes on three days a week. A kind way to respond to difficult moments.',\n  'Problem-solving steps': \"Pick one problem that's on your mind and think through at least three ways to tackle it, for about 10 minutes once a week. A practical way to turn worry into a next step.\",\n  'Stretching': 'Add 10 minutes of mobility or stretching work, three times a week. A simple way to maintain mobility and range of motion.',\n  'Slow breathing to wind down': 'Practise slow breathing for 5 minutes as part of your wind-down, five nights a week. A simple way to help your body settle before sleep.',\n  'Bedtime to-do list': \"Spend 5 minutes before bed writing a to-do list for the next few days, so tomorrow's tasks aren't on your mind.\",\n  'Beans and lentils': 'Include beans, lentils or chickpeas in two meals a week. An easy way to add variety to the meals you already cook.',\n  'Daily eating window': 'Keep your eating within a 10-hour window on at least five days a week. Build this in once your first practices feel settled.'\n};\nconst NAMEL = { 'Walking after meals': 'walking after meals', 'Balance': 'balance', 'Self-compassion': 'self-compassion', 'Stretching': 'stretching', 'Problem-solving steps': 'problem-solving steps', 'Slow breathing to wind down': 'slow breathing to wind down', 'Beans and lentils': 'beans and lentils', 'Bedtime to-do list': 'a bedtime to-do list' };\nconst DIR = {\n  'Structured Cardio': 'Structured cardio could help you continue building aerobic fitness through regular sessions and intervals.',\n  'Cognitive & Emotional Regulation': 'Cognitive and emotional regulation could give you more ways to handle stress and emotions, from reframing and self-talk to self-compassion and problem-solving.',\n  'Rest & Enjoyment': 'Rest and enjoyment could help you make more room for nature, breaks, music and the activities you enjoy.',\n  'Sleep Duration & Support': 'Sleep duration and support could help you keep getting enough sleep, night after night.',\n  'Plant-Rich Eating': 'Plant-rich eating could help you add more vegetables, fruit, whole grains, beans and lentils to your week.',\n  'Mindfulness & Meditation': 'Mindfulness and meditation could help you build calm and focus, through meditation, breathing and yoga.'\n};\n// short citation for \"What supports this\", and full references with their DOI as a link\nconst cite = r => { const au = r.split(/\\(\\d{4}\\)/)[0], parts = au.split(/\\.,\\s+/).map(x => x.replace(/^&\\s*/, '').split(',')[0].trim()).filter(Boolean), yr = (r.match(/\\((\\d{4})\\)/) || [])[1] || ''; const who = parts.length > 2 || /\\.\\s\\.\\s\\./.test(au) ? parts[0] + ' et al.' : parts.join(' & '); const t = (r.split(/\\(\\d{4}\\)\\.\\s*/)[1] || '').split(/\\.\\s/)[0]; return `${who}, ${yr}${t ? '. ' + t : ''}`; };\nconst linkDoi = t => esc(t).replace(/(https?:\\/\\/[^\\s<]+[^\\s<.,)])/g, '<a href=\"$1\" target=\"_blank\" rel=\"noopener\">$1<\/a>');\nconst GL = { focus: 'Focus now', improve: 'Worth improving', well: 'Going well' };\n// the Starting Position as a map: the member at the centre, six dimensions around them in a fixed order,\n// each linked to the centre. Focus now = large filled circle and solid line; worth improving = dashed; going well = fine outline and dotted line.\nfunction mapSvg(r) {\n  // a honeycomb: the member in the centre, the six pillars around them in a fixed order (Nutrition at the top, then clockwise).\n  // Focus now = pink fill and a solid frame; worth improving = white with a dashed frame; going well = white with a fine frame.\n  const R = 94, gap = 8, d = Math.sqrt(3) * R + gap, W = 580, H = 600, cx = W / 2, cy = H / 2;\n  const hex = (x, y, rr) => [0, 60, 120, 180, 240, 300].map(t => { const a = t * Math.PI / 180; return (x + rr * Math.cos(a)).toFixed(1) + ',' + (y + rr * Math.sin(a)).toFixed(1); }).join(' ');\n  const pos = i => { const a = (-90 + i * 60) * Math.PI / 180; return [cx + d * Math.cos(a), cy + d * Math.sin(a)]; };\n  const ICON = {\n    Nutrition: 'M0-3c-3-3-10-2-10 5c0 6 5 10 7 10c1.2 0 2-.8 3-.8s1.8.8 3 .8c2 0 7-4 7-10c0-7-7-8-10-5zM0-3c0-3 1-5 3-6M1-6.5c2-3 5-3.5 6.5-2.5c-1 2.3-4 3.3-6.5 2.5z',\n    Sleep: 'M4-10a10 10 0 1 0 6 16A12 12 0 0 1 4-10z',\n    Movement: 'M-12 7v-12h5l1.5 3h3l1.5-3c2 3 4 5 7 6c3 1 5 2 5 4v2zM-12 7v2.5h24V7M-5-2l2 1.5M-2-4l2 1.5',\n    Mind: 'M0-10a10 10 0 0 1 0 20a10 10 0 0 1 0-20zM-4 0a4 4 0 0 0 8 0',\n    Connection: 'M-4 0a7 7 0 1 1 0 .1zM4 0a7 7 0 1 1 0 .1z',\n    Prevention: 'M0 10C-5 6-11 1.5-11-3.5c0-3.2 2.4-5.8 5.5-5.8c2.4 0 4.2 1.4 5.5 3.6c1.3-2.2 3.1-3.6 5.5-3.6c3.1 0 5.5 2.6 5.5 5.8C11 1.5 5 6 0 10zM-8-1h3.5l1.5-3 2.5 6 2-5 1.5 2h5'\n  };\n  const st = { focus: ['#F5A4C2', '#4D2831', 2, ''], improve: ['#FFFFFF', '#4D2831', 1.6, 'stroke-dasharray=\"7 5\"'], well: ['#FFFFFF', '#4D2831', 1.2, ''] };\n  const cells = AREAS.map((a, i) => { const [x, y] = pos(i), g = r.groups[a], [f, sk, w, da] = st[g];\n    return `<g class=\"hx hx-${g}\"><polygon points=\"${hex(x, y, R)}\" fill=\"${f}\" stroke=\"${sk}\" stroke-width=\"${w}\" ${da} stroke-linejoin=\"round\"/>\n      ${a === 'Connection' ? `<path d=\"M1.71 2.66A6.3 6.3 0 1 1 -2.91-6.2M-2.3-.22A6.3 6.3 0 1 1 3.78 6.3\" transform=\"translate(${x.toFixed(1)} ${(y - 28).toFixed(1)}) scale(1.03)\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.6\" vector-effect=\"non-scaling-stroke\" stroke-linecap=\"round\"/>` : `<path d=\"${ICON[a]}\" transform=\"translate(${x.toFixed(1)} ${(y - 28).toFixed(1)})\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>`}\n      <text x=\"${x.toFixed(1)}\" y=\"${(y + 8).toFixed(1)}\" text-anchor=\"middle\" class=\"mt\">${a.toUpperCase()}<\/text>\n      <text x=\"${x.toFixed(1)}\" y=\"${(y + 32).toFixed(1)}\" text-anchor=\"middle\" class=\"ms\">${GL[g]}<\/text><\/g>`; }).join('');\n  const centre = `<g class=\"hx hx-you\"><polygon points=\"${hex(cx, cy, R)}\" fill=\"#4D2831\"/>\n    <text x=\"${cx}\" y=\"${cy - 4}\" text-anchor=\"middle\" class=\"mc\">${esc(r.name)}<\/text><text x=\"${cx}\" y=\"${cy + 20}\" text-anchor=\"middle\" class=\"mk\">Starting Position<\/text><\/g>`;\n  return `<svg class=\"mapsvg hexmap\" viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"Your six pillars around you, shown as a honeycomb\">${cells}${centre}<\/svg>`;\n}\nfunction ring(a, g, mini) {\n  const fill = { Nutrition: '#FE600C', Sleep: '#FFFFFF', Movement: '#F5A4C2', Mind: '#CB863A', Connection: '#4D2831', Prevention: '#000000' }[a];\n  const v = mini ? 'viewBox=\"0 0 24 24\" class=\"mini\"' : 'viewBox=\"0 0 120 120\"', c = mini ? 12 : 60, R = mini ? 10 : 54, w = mini ? 1.2 : 1.5;\n  if (g === 'focus') return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"${mini ? '#4D2831' : fill}\" stroke=\"#4D2831\" stroke-width=\"${w}\"/><\/svg>`;\n  if (g === 'improve') return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"${w + .3}\" stroke-dasharray=\"${mini ? '1 2.4' : '1.5 5.5'}\" stroke-linecap=\"round\"/><\/svg>`;\n  return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"${w}\"/><\/svg>`;\n}\n\n// generated members bring their own copy and timings\nD.filter(r => r.planned).forEach(r => [...r.steps.m2, ...r.steps.m3, ...r.steps.later].forEach(x => { if (STEPMIN[x.fam] === undefined) STEPMIN[x.fam] = x.min || 0; }));\nD.filter(r => r.gen).forEach(r => { INTRO1[r.name] = r.intro1; SPC[r.name] = r.spc; FOC[r.name] = r.foc; PRC[r.name] = r.prc;\n  if (r.notice) NOTICE[r.name] = r.notice; else delete NOTICE[r.name]; delete PHOTO[r.name];\n  [...r.steps.m2, ...r.steps.m3, ...r.steps.later].forEach(x => { STEPMIN[x.fam] = x.min || 0; }); });\nif (GEN) Object.keys(NXT).forEach(k => delete NXT[k]);\nconst ORDER = r => [...(r.gen ? r.focus : []).filter(a => r.groups[a] === 'focus'), ...AREAS.filter(a => r.groups[a] === 'focus' && !(r.gen && r.focus.includes(a))), ...AREAS.filter(a => r.groups[a] === 'improve'), ...AREAS.filter(a => r.groups[a] === 'well')];\nconst S0 = [\n  // opening: their Good Span, a short portrait, and the Starting Position as one strip of six\n  r => { const op = openingOf(r); return `<div class=\"hero\"><div class=\"htext\">\n    <div class=\"ht\"><h1>Your Good Span<\/h1><p class=\"kicker hk\">${esc(r.name)} · ${esc(r.date || '12 October 2026')}<\/p><p class=\"hsub hlead\">${esc(op.lead)}<\/p><\/div>\n    <div class=\"hls\">${op.paras.map(t => `<p class=\"hl\">${esc(t)}<\/p>`).join('')}<\/div>\n    <\/div>${(() => { const k = PHOTO[r.name] || r.focus[0]; return IMG[k] ? `<figure class=\"hfig\"><img src=\"${IMG[k]}\" alt=\"${esc(ALT[k])}\"><figcaption><span class=\"chip p-${r.focus[0]}\">${esc(r.focus[0])}<\/span><\/figcaption><\/figure>` : ''; })()}\n  <\/div>\n    ${NOTICE[r.name] ? `<div class=\"check check-top notice\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"15\" fill=\"#CB863A\"/><circle cx=\"24\" cy=\"24\" r=\"20\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\" stroke-dasharray=\"2 3\"/><\/svg><div><h3>${esc(NOTICE[r.name].title)}<\/h3><p style=\"margin-top:6px\">${esc(NOTICE[r.name].text)}<\/p><\/div><\/div>` : ''}\n    ${r.safety ? `<div class=\"check check-top\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"24\" r=\"14\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\"/><circle cx=\"28\" cy=\"24\" r=\"14\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\" stroke-dasharray=\"2 3\"/><\/svg><div><h3>${esc(r.safety.title)}<\/h3><p style=\"margin-top:6px\">${esc(r.safety.text)}<\/p><\/div><\/div>` : ''}`; },\n\n  // Your Starting Position: one label and a short reading per pillar, in the order of the strip\n  r => `<h1>Your Starting Position<\/h1>\n    <p class=\"secsub\">A clear picture of where you are today across six connected dimensions<\/p>\n    <p class=\"lead\">Here is what is already supporting your wellbeing, and where focusing your effort could help you move forward most.<\/p>\n    <figure class=\"map\" aria-label=\"Your Starting Position across the six pillars\">\n      ${mapSvg(r)}\n      <ul class=\"sr-only\">${AREAS.map(a => `<li>${a}: ${GL[r.groups[a]]}<\/li>`).join('')}<\/ul>\n      <figcaption class=\"mlegend\"><span><svg class=\"mini hxm\" viewBox=\"0 0 24 22\" aria-hidden=\"true\"><polygon points=\"6,1 18,1 23,11 18,21 6,21 1,11\" fill=\"#F5A4C2\" stroke=\"#4D2831\" stroke-width=\"1.6\"  stroke-linejoin=\"round\"/><\/svg> Focus now<\/span><span><svg class=\"mini hxm\" viewBox=\"0 0 24 22\" aria-hidden=\"true\"><polygon points=\"6,1 18,1 23,11 18,21 6,21 1,11\" fill=\"#FFFFFF\" stroke=\"#4D2831\" stroke-width=\"1.3\" stroke-dasharray=\"3 2.5\" stroke-linejoin=\"round\"/><\/svg> Worth improving<\/span><span><svg class=\"mini hxm\" viewBox=\"0 0 24 22\" aria-hidden=\"true\"><polygon points=\"6,1 18,1 23,11 18,21 6,21 1,11\" fill=\"#FFFFFF\" stroke=\"#4D2831\" stroke-width=\"1\"  stroke-linejoin=\"round\"/><\/svg> Going well<\/span><\/figcaption>\n    <\/figure>\n    <div class=\"brief\">${ORDER(r).map(a => { const [lab, txt] = (SPC[r.name] || {})[a] || [GL[r.groups[a]], r.prof.pillars[a]]; return `<div class=\"bp a-${a} g-${r.groups[a]}\"><div class=\"bh\"><h3>${a}<\/h3><span class=\"tag t-${r.groups[a]}\">${esc(lab)}<\/span><\/div><p>${esc(txt)}<\/p><\/div>`; }).join('')}<\/div>`,\n\n  r => `<h1>Where your effort will count most<\/h1>\n    <div class=\"fstack\">${r.focus.map(a => { const f = (FOC[r.name] || {})[a] || (r.foc || {})[a] || { p: r.reasons[a] || [], well: [] }; return `<div class=\"fcard fwide a-${a}\">\n      <div class=\"fmain\"><span class=\"chip\">Your focus<\/span><span class=\"fh\">${a}<\/span>${f.p.map(t => `<p>${esc(t)}<\/p>`).join('')}<\/div>\n      ${f.well.length ? `<div class=\"fwell\"><h3>What you're already doing well<\/h3><ul>${f.well.map(t => `<li>${esc(t)}<\/li>`).join('')}<\/ul><\/div>` : ''}<\/div>`; }).join('')}<\/div>\n    <p class=\"lead\">We'll build on these habits instead of asking you to start from scratch.<\/p>`,\n\n  // section 4: first practices, each with what to do, how to make it work and why\n  r => { const nr = r.practices.filter((x, i) => isRec(r, x, i)).length, ne = r.practices.length - nr; return `<h1>Your month ahead<\/h1>\n    <p class=\"lead\">${cap1(NUMW[nr])} recommended practice${nr === 1 ? '' : 's'} to start with${ne ? `, and ${NUMW[ne]} more you can add if you have time` : ''}. Each one is chosen around what matters to you and the time you have.<\/p>\n    <div class=\"prs\">${r.practices.map((x, i) => { const rec = isRec(r, x, i), c = (rec || r.gen ? (PRC[r.name] || [])[i] : null) || { t: STEPNAME[x.fam] || x.fam, a: x.action + ' ' + x.freq + '.', time: x.over ? `About ${x.min} minutes a week, more than your usual time, so only if you have room.` : x.min ? `About ${x.min} minutes a week.` : 'No extra time set aside.', make: [x.start], why: x.why }; return `<article class=\"pr a-${x.area} ${rec ? 'is-rec' : 'is-extra'}\"><div class=\"hd\"><div class=\"prtags\"><span class=\"chip\">${esc(x.area)}<\/span><span class=\"rtag\">${rec ? 'Recommended' : 'If you have time'}<\/span><\/div><span class=\"pnum\">${String(i + 1).padStart(2, '0')} · ${esc(c.t)}<\/span>\n      <p class=\"act\">${esc(c.a)}<\/p><\/div><div class=\"bd\">\n      <dl>${c.time ? `<dt>Time<\/dt><dd><p>${esc(c.time)}<\/p><\/dd>` : ''}<dt>Make it work for you<\/dt><dd>${c.make.map(t => `<p>${esc(t)}<\/p>`).join('')}<\/dd>${c.why ? `<dt>Why this practice<\/dt><dd><p>${esc(c.why)}<\/p><\/dd>` : ''}<\/dl>\n      ${(x.refs || []).length ? `<details><summary>What supports this<\/summary><ul class=\"srcs\">${x.refs.map(t => `<li>${linkDoi(t)}<\/li>`).join('')}<\/ul><\/details>` : ''}<\/div><\/article>`; }).join('')}<\/div>\n    <!-- \"Designed to fit your life\" removed from the page; fitBlock(r) still available -->\n    ${r.found.length ? `<div class=\"later\"><p class=\"kicker\">Optional everyday habits<\/p><ul>${r.found.map(f => `<li>${esc(f.text)} <span class=\"note\">${esc(f.why)}<\/span><\/li>`).join('')}<\/ul><\/div>` : ''}`; },\n\n  // the six-month journey, with the next practices and the weekly time at each step\n  r => { const st = r.steps || { m2: [], m3: [], later: [] }; const add = a => a.reduce((t, x) => t + (STEPMIN[x.fam] || 0), 0);\n    const t1 = pmins(r), t2 = t1 + add(st.m2), t3 = t2 + add(st.m3), mins = v => v ? `About ${v} minutes a week in all` : 'Still no extra activity time';\n    const item = x => `<li class=\"js\"><span class=\"chip p-${x.area}\">${esc(x.area)}<\/span><b>${esc(STEPNAME[x.fam] || x.fam)}<\/b><span>${esc(NXT[x.fam] || (x.action + ' ' + x.freq + '.'))}<\/span>${(x.refs || []).length ? `<details class=\"jref\"><summary>What supports this<\/summary><ul class=\"srcs\">${x.refs.map(t => `<li>${linkDoi(t)}<\/li>`).join('')}<\/ul><\/details>` : ''}<\/li>`;\n    const t = r.themes.length;\n    return `<h1>Your six-month journey<\/h1>\n    <p class=\"lead\">Your Good Span is a starting point, not a fixed prescription. Each month, you'll reflect on what's working, adapt what isn't and decide what comes next. New practices join one at a time, once the earlier ones feel familiar.<\/p>\n    <div class=\"roadwrap\">${ARC([['104%', '-22%', 150, '#4D2831', 'solid', 1.5], ['-3%', '112%', 110, '#FFFFFF', 'dot', 2]])}<ol class=\"road vroad\">\n      <li class=\"now\"><span class=\"pt\"><\/span><span class=\"what\">Month 1 · Begin<\/span><p>${(() => { const nr = r.practices.filter((x, i) => isRec(r, x, i)).length, ne = r.practices.length - nr; return `Get familiar with your ${nr === 1 ? 'recommended practice' : NUMW[nr] + ' recommended practices'} and find ways to make ${nr === 1 ? 'it' : 'them'} part of your week${ne ? `. If you have time, add ${ne === 1 ? 'the other one' : 'one or both of the other two'}` : ''}.`; })()}<\/p><p class=\"jt\">${t1 ? `About ${t1} minutes a week` : 'No extra activity time'}<\/p><\/li>\n      <li class=\"mid\"><span class=\"pt\"><\/span><span class=\"what\">Month 2 · Build<\/span><p>Keep the practices that are working${st.m2.length ? ' and, when you feel ready, add:' : '.'}<\/p>${st.m2.length ? `<ul class=\"jsl\">${st.m2.map(item).join('')}<\/ul><p class=\"jt\">${mins(t2)}<\/p>` : ''}<\/li>\n      <li class=\"mid\"><span class=\"pt\"><\/span><span class=\"what\">Month 3 · Refine<\/span><p>Review your progress and adjust your practices to fit your routines, priorities and experience${st.m3.length ? '. If it feels right, add:' : '.'}<\/p>${st.m3.length ? `<ul class=\"jsl\">${st.m3.map(item).join('')}<\/ul><p class=\"jt\">${mins(t3)}, within the ${esc(r.timeTxt)} you told us you have<\/p>` : ''}<\/li>\n      <li><span class=\"pt\"><\/span><span class=\"what\">Months 4–5 · Deepen<\/span><p>Explore the next practices in your focus areas, building on what you've learned so far${st.later.length ? `, such as ${list(st.later.map(x => `<b>${esc(STEPNAME[x.fam] || x.fam)}<\/b>`))}. Where time is tight, a new practice can replace one that is already a habit` : ''}.<\/p><\/li>\n      <li><span class=\"pt\"><\/span><span class=\"what\">Month 6 · Consolidate<\/span><p>Identify the habits that matter most to you and make them easier to sustain beyond the programme.<\/p><\/li>\n      <li class=\"end\"><span class=\"pt\"><\/span><span class=\"what\">After six months: Your New Position<\/span><p>Revisit the six dimensions to see how your habits and priorities have evolved since your Starting Position. Review your New Position with your Pilot and decide what you want to focus on next.<\/p><\/li>\n    <\/ol>\n    <div class=\"later\"><p class=\"kicker\">${t === 1 ? 'One possible next direction' : NUMW[t].charAt(0).toUpperCase() + NUMW[t].slice(1) + ' possible next directions'}<\/p>${r.themes.map(x => `<p>${esc(DIR[x[1]] || x[1] + '. ' + x[2])}<\/p>`).join('')}<p>Or you can keep going with what's working. Maintaining a habit that supports your wellbeing is progress too.<\/p><\/div><\/div>`; },\n\n  // section 8: belonging, then the next step: meet your Pilot (before any choice of support)\n  r => `<div class=\"close\">\n    <h2>Ready to make your Good Span part of everyday life?<\/h2>\n    <p class=\"belong\">Longevity is personal. It shouldn't be lonely.<\/p>\n    <p>This is your starting Good Span. It is personal to you, but the journey doesn't have to be solitary. Over the next six months, a Pilot works alongside you, and you'll be part of a community of members on the same journey.<\/p><\/div>\n    <div class=\"nextstep\">\n      <div class=\"nshead\"><p class=\"kicker\">Your next step<\/p><h2 class=\"sh\">Choose how you'd like to continue<\/h2>\n      <p class=\"lead\">Your Good Span is ready. Review it with your Pilot, or explore the memberships and start in the way that suits you.<\/p><\/div>\n      <div class=\"nopts\">\n        <article class=\"nopt nopt-1\"><p class=\"nnum\">01 · Recommended<\/p><h3>Meet your Pilot<\/h3>\n          <p>Talk through your Starting Position and first practices, ask questions, and refine your Good Span to fit your life.<\/p>\n          <ul><li><svg viewBox=\"0 0 22 22\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M6.5 11.3l3 3 6-6.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/svg>Review your Starting Position together<\/li><li><svg viewBox=\"0 0 22 22\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M6.5 11.3l3 3 6-6.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/svg>Adjust anything that doesn't fit<\/li><li><svg viewBox=\"0 0 22 22\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"/><path d=\"M6.5 11.3l3 3 6-6.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/svg>Decide on the support that suits you<\/li><\/ul>\n          <div class=\"nfoot\"><p class=\"nmeta\">20 minutes · Online · No preparation needed<\/p><button class=\"btn pbtn\" type=\"button\">Book my Good Span Review<\/button><\/div><\/article>\n        <article class=\"nopt nopt-2\"><p class=\"nnum\">02 · On your own<\/p><h3>Prefer to go self-guided?<\/h3>\n          <p>Choose Self for €25/month and follow your personalised plan independently. Use the Member App and Practice Journal to keep up with your practices and reflect on your progress month by month.<\/p>\n          <div class=\"nfoot\"><p class=\"nmeta\">Six-month membership · Choose online<\/p><button class=\"btn obtn\" type=\"button\" data-go=\"5\">Choose Self<\/button><\/div><\/article>\n      <\/div><\/div>`,\n\n  // section 9: the support options, explained so they can be discussed with the Pilot (chosen after the Review, not here)\n  r => `<h1>Choose the support that suits you<\/h1>\n    <p class=\"lead\">Every membership includes the same foundations; the difference is how much individual support you want along the way. Not sure yet? Your Pilot can help you decide in your Good Span Review.<\/p>\n    <div class=\"incl\"><h3>What's included in every membership<\/h3>\n      <ul>${[['Your Starting Position', 'a clear picture of where you are today across the six dimensions.'], ['Practices chosen for you', `${NUMW[r.practices.length]} personalised practices for your first month, focused on what matters most for you.`], ['A six-month Good Span', 'that evolves as you progress.'], ['A Pilot welcome conversation', 'review your Starting Position and refine your practices.'], ['Member App and Practice Journal', 'follow your practices and reflect on your progress.'], ['Monthly Longevity Live', 'join the session live or watch the replay.'], ['Member connections and gatherings', 'opportunities to learn and connect with others.'], ['Preferred member rates', 'access curated specialists, products and services at member rates.'], ['Your six-month review', 'revisit the six dimensions and review your New Position with your Pilot.']].map(([b, t]) => `<li><svg viewBox=\"0 0 28 28\" aria-hidden=\"true\"><circle cx=\"14\" cy=\"14\" r=\"13\" fill=\"#4D2831\"/><path d=\"M8.5 14.5l3.6 3.6 7.4-7.6\" fill=\"none\" stroke=\"#FFF2EA\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/svg><div><b>${esc(b)}<\/b><span>${esc(cap1(t))}<\/span><\/div><\/li>`).join('')}<\/ul><\/div>\n    <div class=\"tiers\">\n      <div class=\"tier t-Self\" data-t=\"Self\"><span class=\"ui\">Self<\/span><span class=\"price\">€19<small>/month<\/small><\/span><span class=\"pterm\">Six-month commitment<\/span><p class=\"tl\">Your Good Span, on your terms.<\/p>\n        <p>Follow your Good Span independently, with a Pilot welcome conversation to review your Starting Position and refine your practices.<\/p>\n        <p>Over your six months, use the Member App and Practice Journal to follow your practices and reflect on your progress.<\/p>\n        <div class=\"tfoot\"><button class=\"btn tchoose\" type=\"button\">Choose Self<\/button><p class=\"trial\">Prefer to try it first? A one-month trial is available for €25, without Pilot support.<\/p><\/div><\/div>\n      <div class=\"tier t-Core\" data-t=\"Core\"><span class=\"ui\">Core<\/span><span class=\"price\">€129<small>/month<\/small><\/span><span class=\"pterm\" aria-hidden=\"true\">&nbsp;<\/span><p class=\"tl\">Personal guidance to keep you moving forward.<\/p>\n        <p>Take the lead day to day, with a Pilot who follows your progress, helps you work through challenges and adapts your Good Span with you.<\/p>\n        <p>Your membership includes regular Pilot reviews, WhatsApp support between reviews and a quarterly €50 Refuel.<\/p>\n        <div class=\"tfoot\"><button class=\"btn tchoose\" type=\"button\">Choose Core<\/button><\/div><\/div>\n      <div class=\"tier t-Concierge\" data-t=\"Concierge\"><span class=\"ui\">Concierge<\/span><span class=\"price\">€249<small>/month<\/small><\/span><span class=\"pterm\" aria-hidden=\"true\">&nbsp;<\/span><p class=\"tl\">More individual attention, coordinated around you.<\/p>\n        <p>Work closely with a Pilot who understands your goals, helps you adapt your Good Span and coordinates additional expertise when you need it.<\/p>\n        <p>Your membership includes extended Pilot reviews, direct WhatsApp support, a quarterly specialist consultation and a €100 quarterly Refuel.<\/p>\n        <div class=\"tfoot\"><button class=\"btn tchoose\" type=\"button\">Choose Concierge<\/button><\/div><\/div>\n    <\/div>\n    <div class=\"pcta pcta2\"><button class=\"btn pbtn\" type=\"button\">Book my Good Span Review<\/button><p class=\"pmeta\">Or decide with your Pilot · 20 minutes · online<\/p><\/div>\n    <div class=\"dlbox\"><div><h3>Keep your Good Span<\/h3><p>Download your plan to read again, print or share with your Pilot.<\/p><\/div><button class=\"btn dlbtn\" type=\"button\" data-dl=\"1\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><\/svg>Download my Good Span<\/button><p class=\"dlmsg\" role=\"status\"><\/p><\/div>`\n];\n// the opening and the Starting Position share the first screen\nconst S = [r => S0[0](r) + '<div class=\"spos\">' + S0[1](r).replace('<h1>', '<h2 class=\"sh\">').replace('<\/h1>', '<\/h2>') + '<\/div>', ...S0.slice(2)];\n\n// progressive disclosure: one section at a time, in order. Earlier sections can be revisited from the step bar.\nconst STEPNAMES = r => ['Your Good Span', 'Where to focus', 'Your month ahead', 'Your six-month journey', 'Choose how to continue', 'Membership options'];\nlet seen = 0, back = null;   // furthest step reached; where to return after a jump to the references\nconst reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;\nfunction render() {\n  const r = D[who];\n  document.getElementById('who').hidden = D.length < 2;\n  document.getElementById('who').innerHTML = D.map((m, i) => `<button type=\"button\" aria-pressed=\"${i === who}\" data-w=\"${i}\">${esc(m.name)}<\/button>`).join('');\n  document.getElementById('screens').innerHTML = S.map((f, k) => `<section class=\"screen\" id=\"sec-${k + 1}\" aria-labelledby=\"sh-${k + 1}\" hidden>${(k ? f(r).replace(/<h1>/, `<h2 class=\"sh\" id=\"sh-${k + 1}\" tabindex=\"-1\">`).replace(/<h1>/g, '<h2 class=\"sh\">').replace(/<\\/h1>/g, '<\/h2>') : f(r).replace('<h1>', `<h1 id=\"sh-${k + 1}\" tabindex=\"-1\">`))}<\/section>`).join('');\n  // sections whose heading is an h2 already (Meet your Pilot, references) get the id on that heading\n  document.querySelectorAll('.screen').forEach((sec, k) => { if (!sec.querySelector('#sh-' + (k + 1))) { const h = sec.querySelector('h1,h2'); if (h) { h.id = 'sh-' + (k + 1); h.tabIndex = -1; } } });\n  show(step, true);\n}\nfunction show(k, quiet) {\n  const r = D[who], names = STEPNAMES(r), n = S.length;\n  step = Math.max(0, Math.min(n - 1, k)); seen = Math.max(seen, step);\n  document.querySelectorAll('.screen').forEach((sec, i) => { sec.hidden = i !== step; });\n  const nav = `<nav class=\"stepnav\" aria-label=\"Your Good Span, section by section\">\n    ${back !== null ? `<button type=\"button\" class=\"btn ghost\" data-go=\"${back}\">Back to where you were<\/button>` : step > 0 ? `<button type=\"button\" class=\"btn ghost\" data-go=\"${step - 1}\">Back<\/button>` : '<span><\/span>'}\n    ${step < n - 1 ? `<button type=\"button\" class=\"btn next\" data-go=\"${step + 1}\">${step + 1 === n - 1 ? 'Explore membership options' : esc(names[step + 1])} →<\/button>` : `<button type=\"button\" class=\"btn ghost\" data-go=\"0\">Back to the beginning<\/button>`}<\/nav>`;\n  document.querySelectorAll('.stepnav').forEach(x => x.remove());\n  document.getElementById('sec-' + (step + 1)).insertAdjacentHTML('beforeend', nav);\n  document.getElementById('steps').innerHTML = `<ol class=\"sbar\">${names.map((t, i) => `<li class=\"${i < step ? 'done' : i === step ? 'now' : ''}\">${i <= seen ? `<button type=\"button\" data-go=\"${i}\" aria-label=\"${esc(t)}\"${i === step ? ' aria-current=\"step\"' : ''}><\/button>` : `<span aria-hidden=\"true\"><\/span>`}<\/li>`).join('')}<\/ol><p class=\"sname\"><span>${step + 1} of ${n}<\/span> ${esc(names[step])}<\/p>`;\n  if (!quiet) { scrollTo({ top: 0, behavior: reduceMotion() ? 'auto' : 'smooth' }); const h = document.getElementById('sh-' + (step + 1)); if (h) h.focus({ preventScroll: true }); }\n}\n// download: the plan itself (opening, Starting Position, focus, month ahead and journey) as one file the member keeps.\n// The file opens in any browser, offline, with every section and reference shown, and a button to print or save as PDF.\nfunction planFile(r) {\n  const css = [...document.querySelectorAll('style')].map(x => x.textContent).join('\\n');\n  const body = S.slice(0, 4).map((f, k) => `<section class=\"screen\">${k ? f(r).replace(/<h1>/g, '<h2 class=\"sh\">').replace(/<\\/h1>/g, '<\/h2>') : f(r)}<\/section>`).join('').replace(/<details/g, '<details open');\n  const logo = document.querySelector('.top img').src;\n  return `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Good Span · ${esc(r.name)}<\/title><style>${css}\n    .screen{animation:none}#screens{gap:56px}.printbar{display:flex;justify-content:center;margin:8px 0 0}\n    @page{size:A4;margin:14mm 12mm}\n    @media print{.printbar{display:none}html,body{background:#fff!important;padding:0}.shell{max-width:none;padding:0}#screens{gap:28px}\n      .screen,.roadwrap,.road,.road li,.fstack,.prs{break-inside:auto;overflow:visible!important}\n      .hero,.bp,.fcard,.road.vroad li.js,.later,.check,.map,.jref,.srcs li,.pr .hd,.pr dl>*{break-inside:avoid}\n      .pr{break-inside:auto}h1,h2,h3,.sh{break-after:avoid}\n      *{-webkit-print-color-adjust:exact;print-color-adjust:exact;animation:none!important}\n      #screens,.screen,.spos,.prs,.fstack,.roadwrap,.road,.road.vroad{display:block!important}\n      .screen>*,.spos>*,.prs>*,.fstack>*,.roadwrap>*{margin-bottom:16px}\n      .pr dl{display:block!important}.pr dt{margin-top:12px}.pr dd{margin:4px 0 0}\n      .road.vroad>li{display:block!important;position:relative;padding:0 0 0 38px!important;margin:0 0 20px}\n      .road.vroad>li>.pt{position:absolute;left:0;top:2px}.road.vroad>li::before{display:none!important}\n      .road.vroad li.js{display:block!important;padding:14px 16px!important;margin:10px 0!important;position:static}\n      .road.vroad li.js>b,.road.vroad li.js>span:not(.chip),.road.vroad li.js>.jref{display:block;margin-top:6px}}<\/style><\/head>\n    <body><div class=\"shell\"><header class=\"top\"><img src=\"${logo}\" alt=\"The Good Span\"><\/header>\n    <div class=\"printbar\"><button class=\"btn dlbtn\" type=\"button\" onclick=\"window.print()\">Print or save as PDF<\/button><\/div>\n    <main id=\"screens\">${body}<\/main><\/div><\/body><\/html>`;\n}\nasync function downloadPlan(btn) {\n  const r = D[who], name = `Good Span - ${r.name}.html`, html = planFile(r), msg = btn.parentElement.querySelector('.dlmsg');\n  const say = t => { if (msg) msg.textContent = t; };\n  let dl = null;\n  try { dl = window.claude && window.claude.use ? await window.claude.use('downloads') : null; } catch (err) { dl = null; }\n  if (dl) {\n    try { await dl.save({ filename: name, data: html }); say('Saved. Open the file in any browser, or print it as a PDF.'); }\n    catch (err) { if (err && err.code !== 'declined') say(\"Sorry, the download isn't available here.\"); }\n    return;\n  }\n  try { const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' })); a.download = name; document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); say('Downloaded. Open the file in any browser, or print it as a PDF.'); }\n  catch (err) { say(\"Sorry, the download isn't available here.\"); }\n}\ndocument.addEventListener('click', e => {\n  const dlb = e.target.closest('[data-dl]'); if (dlb) { downloadPlan(dlb); return; }\n  const refs = open => { const m = document.getElementById('refmore'), b = document.querySelector('.reft'); if (!m || !b) return; m.hidden = !open; b.setAttribute('aria-expanded', open); b.textContent = open ? 'Show fewer references' : 'Show all references'; };\n  if (e.target.closest('a[href=\"#references\"]')) { e.preventDefault(); back = step; show(S.length - 1); refs(true); return; }\n  const rt = e.target.closest('.reft'); if (rt) refs(rt.getAttribute('aria-expanded') !== 'true');\n  const g = e.target.closest('[data-go]'); if (g) { const to = +g.dataset.go; back = null; show(to); return; }\n  const w = e.target.closest('[data-w]'); if (w) { who = +w.dataset.w; step = 0; seen = 0; back = null; render(); scrollTo(0, 0); }\n});\ndocument.addEventListener('keydown', e => { if (e.target.closest('input,textarea,select,summary')) return; if (e.key === 'ArrowRight' && step < S.length - 1) { back = null; show(step + 1); } if (e.key === 'ArrowLeft' && step > 0) { back = null; show(step - 1); } });\nrender();\n<\/script>\n";
