:6px}\n.notice h3{color:var(--plum)}\n.fitb{min-width:0}\n.tbr li{flex-wrap:wrap}\n.tbr b{white-space:normal}\n.pterm{font-size:14px;margin-top:-6px}\n/* Starting Position map */\n.mapsvg{width:min(560px,100%);height:auto;display:block}\n.mapsvg .mt{font-family:var(--ui);font-size:14px;letter-spacing:.07em}\n.mapsvg .ms{font-family:var(--display);font-size:17px;font-weight:300}\n.mapsvg .mc{font-family:var(--display);font-size:19px;font-weight:400}\n.mn-focus .mt{font-size:15px}\n.mlegend svg.mini{width:34px;height:14px}\n.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n@media (max-width:520px){.mapsvg .ms{display:none}.mapsvg .mt{font-size:19px;letter-spacing:.03em}.mapsvg .mc{font-size:24px}}\n.mapsvg .rl{font-family:var(--ui);font-size:11px;letter-spacing:.08em;text-transform:uppercase;fill:#7A5A5F}\n.mapsvg .mt{fill:#4D2831}.mapsvg .ms{fill:#7A5A5F}\n.mapsvg .ml-focus .mt{font-weight:700;fill:#000}.mapsvg .ml-focus .ms{fill:#4D2831}\n.mapsvg{width:min(620px,100%)}\n@media (max-width:520px){.mapsvg .ms{display:none}.mapsvg .mt{font-size:22px}}\n/* \"What's included\" card in light blue */\n.incl{background:var(--blue);color:var(--plum);padding:clamp(28px,5vw,44px);gap:16px}\n.incl h3{font-size:clamp(24px,3vw,30px)}\n.incl ul{gap:12px}\n.incl li{font-size:18px;line-height:1.5}\n.incl h3,.incl li,.incl li b{color:var(--plum)}\n.incl li::marker{color:var(--plum)}\n/* journey step cards: more room around the pillar tag and text */\n.jsl{gap:12px;margin-top:10px}\n.js{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;padding:18px 20px 18px;border-radius:18px}\n.js .chip{grid-row:auto;justify-self:start;margin-bottom:6px}\n.road.vroad li.js{display:grid;grid-template-columns:minmax(0,1fr);column-gap:0;gap:6px;padding:18px 20px;margin:0}\n.road.vroad li.js>*{grid-column:auto!important}\n.road.vroad li.js::before{display:none}\n.road.vroad li.js b{font-size:18px}\n.road.vroad li.js span:last-child{font-size:15px;line-height:1.5}\n/* \"Designed to fit your life\" on light blue */\n.fitb{background:var(--blue)}\n.fitb .tbr li{border-bottom-color:rgba(77,40,49,.3)}\n/* weekly totals in the journey: small label */\n.road.vroad p.jt{font-size:11px;line-height:1.4;letter-spacing:.08em;margin-top:4px}\n.road.vroad p.jt{max-width:none;white-space:nowrap}\n@media (max-width:760px){.road.vroad p.jt{white-space:normal}}\n.who[hidden]{display:none}\n/* opening: the conclusion first */\n.hero .hlead{font-size:clamp(24px,3.2vw,32px);line-height:1.2;font-weight:300;max-width:24ch;margin-top:6px}\n.close .belong{font-size:clamp(20px,2.4vw,24px);font-weight:300;line-height:1.3}\n.pcta2{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px;margin-top:20px}\n.tier .tfoot:empty{display:none}\n/* pillar cards on the plan: white, with no filler colour */\n.bp.g-focus{background:var(--white);color:var(--ink)}\n.bp.g-focus .tag{border-color:var(--plum);color:inherit;background:transparent}\n.fcard,.fcard.a-Sleep{background:var(--white);color:var(--ink)}\n.fcard .chip{color:inherit;box-shadow:inset 0 0 0 1px currentColor}\n.fwell,.a-Connection .fwell,.a-Prevention .fwell,.fcard.a-Sleep .fwell{background:var(--white);color:var(--plum);box-shadow:inset 0 0 0 1px rgba(77,40,49,.22)}\n.pr,.pr.a-Sleep{background:var(--white)}\n.pr .hd,.pr.a-Sleep .hd{background:var(--white);color:var(--ink);border-bottom:1px solid var(--line)}\n.pr .hd .chip{color:inherit;box-shadow:inset 0 0 0 1px currentColor}\n<\/style>\n\n<div class=\"shell\">\n  <header class=\"top\">\n    <img src=\"data:image/png;base64,\" alt=\"The Good Span\">\n    <div class=\"who\" role=\"group\" aria-label=\"Member\" id=\"who\"><\/div>\n  <\/header>\n  <main id=\"screens\"><\/main>\n<\/div>\n\n<script>\nconst D = __DATA__;\n// generated from a member's own answers (the conversation): the hand-written copy below is not used\nconst GEN = D.some(r => r.gen);\n// practices taken out of a member's line-up after review (no clear link to their answers)\nconst DROP = { Hugo: ['Daily eating window'] };\n// month 1 is at most three practices, not a target; each must trace back to an answer. Later months stay within the time limit.\nconst PLAN = {\n  'Inês': { keep: ['Weekly cardio'], m2: ['Walking after meals'], m3: ['Balance'], later: [] },\n  'Marta': { keep: ['Reframing', 'Savouring'], m2: ['Self-compassion'], m3: ['Weekly cardio'], later: ['Problem-solving steps', 'Walking after meals', 'Stretching'] },\n  'Hugo': { keep: ['Enough sleep', 'Balanced plate'], m2: ['Slow breathing to wind down', 'Beans and lentils'], m3: ['Bedtime to-do list'], later: [], refs: { 'Balanced plate': /Aune/ } }\n};\n// extra minutes a week each later practice adds (Balance counted at its 11-minute start)\nconst STEPMIN = { 'Walking after meals': 50, 'Balance': 33, 'Self-compassion': 15, 'Weekly cardio': 30, 'Problem-solving steps': 10, 'Stretching': 30, 'Slow breathing to wind down': 25, 'Bedtime to-do list': 35, 'Beans and lentils': 0 };\nconst STEPNAME = { 'Weekly cardio': 'Aerobic activity' };\nD.forEach(r => { if (r.gen) return; const d = DROP[r.name] || []; for (const a in r.lineup) r.lineup[a] = r.lineup[a].filter(x => !d.includes(x.fam)); r.later = r.later.filter(x => !d.includes(x.fam)); });\nD.forEach(r => { const pl = PLAN[r.name]; if (!pl || r.gen) return; const pool = [...r.practices, ...Object.values(r.lineup).flat(), ...r.later]; const get = f => ({ ...pool.find(x => x.fam === f) });\n  r.practices = pl.keep.map(get); r.practices.forEach(x => { const re = (pl.refs || {})[x.fam]; if (re) x.refs = (x.refs || []).filter(t => re.test(t)); });\n  r.steps = { m2: pl.m2.map(get), m3: pl.m3.map(get), later: pl.later.map(get) }; r.add2 = pl.m2; r.add3 = pl.m3; });\nconst AREAS = ['Nutrition', 'Sleep', 'Movement', 'Mind', 'Connection', 'Prevention'];\nconst STEPS = ['Your Starting Position', 'Your Starting Position', 'Where a small change could go a long way', 'Your first practices', 'Designed to fit your life', 'Your six-month Good Span', 'Ready to start'];\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst low = s => s ? s.charAt(0).toLowerCase() + s.slice(1) : s;\nconst list = a => a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];\nlet who = 0, step = 0;\n\n// one circle per pillar: filled = focus now, dotted outline = worth improving, solid outline = going well\nfunction circle(area, g) {\n  const fill = { Nutrition: '#FE600C', Sleep: '#FFF2EA', Movement: '#F5A4C2', Mind: '#CB863A', Connection: '#4D2831', Prevention: '#000000' }[area];\n  if (g === 'focus') return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"${fill}\" stroke=\"#4D2831\" stroke-width=\"1.5\"/><circle cx=\"60\" cy=\"60\" r=\"34\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1\" stroke-dasharray=\"2 5\"/><\/svg>`;\n  if (g === 'improve') return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.5\" stroke-dasharray=\"1.5 6\" stroke-linecap=\"round\"/><\/svg>`;\n  return `<svg viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.5\"/><\/svg>`;\n}\n// open line arcs from the identity's graphic language: solid, dashed and dotted, no more than three styles\nconst ARC = (cfg) => `<div class=\"arcs\" aria-hidden=\"true\">${cfg.map(([x, y, r, col, style, w]) => `<svg style=\"left:${x};top:${y};width:${r * 2}px;height:${r * 2}px;transform:translate(-50%,-50%)\" viewBox=\"0 0 ${r * 2} ${r * 2}\"><circle cx=\"${r}\" cy=\"${r}\" r=\"${r - 2}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"${w || 1.5}\" ${style === 'dash' ? 'stroke-dasharray=\"10 8\"' : style === 'dot' ? 'stroke-dasharray=\"1 7\" stroke-linecap=\"round\"' : ''}/><\/svg>`).join('')}<\/div>`;\n// the opening: within ten seconds the member should feel understood, see that it's manageable, and know where it starts.\n// The reasoning (time, pace, method) comes later, in the Starting Position and \"Designed to fit your life\".\nconst OPEN = {\n  'Inês': { lead: \"Inês, you're already doing a lot right.\", paras: ['Your answers show strong foundations across much of your everyday life. Rather than giving you more things to do, we think the best place to start is surprisingly small: a little more aerobic movement.'], starts: ['One practice', 'Movement', 'about 30 minutes a week'] },\n  'Marta': { lead: 'Marta, your Good Span starts with what matters most to you: feeling better day to day.', paras: ['You already have strong foundations in sleep, nutrition and connection. But you told us that stress and difficult emotions have been taking up more space recently.', \"You also told us meditation and journalling aren't for you, so your starting practices don't rely on either.\"], starts: ['Two practices', 'Mind first', 'about 15 minutes a week'] },\n  'Hugo': { lead: 'Hugo, you told us you want to improve your fitness. One thing comes first.', paras: [\"Because you mentioned chest discomfort during exercise, we'd hold off on increasing your activity until you've discussed it with a doctor.\", \"That doesn't mean your Good Span has to wait.\", 'Your answers point to sleep and nutrition as useful places to start now.'], starts: ['Two practices', 'Sleep and Nutrition', 'no extra time set aside'] }\n};\nconst openingOf = r => r.opening || OPEN[r.name] || { lead: r.name + ', here’s where we’d start.', paras: [], starts: [] };\n// (earlier opening portrait, kept for reference; no longer shown)\nconst INTRO1 = {\n  'Inês': 'You have already built some good habits across your everyday life. Movement is the area where a little more consistency could make the biggest difference to your next steps.',\n  'Marta': \"You told us you'd like support with your mental wellbeing, especially managing stress and difficult emotions. That's where your Good Span starts. A little more movement can follow from month 3, since you're already close to the guideline.\",\n  'Hugo': [\"You told us you'd like to move more and build your fitness. Before we suggest any increase in activity, there's one important thing to discuss with a doctor first, explained just below.\", 'In the meantime, your answers point to sleep and nutrition, where a small change could make a real difference while movement waits.']\n};\nfunction intro(r) {\n  const n = r.practices.length, num = ['', 'one practice', 'two practices', 'three practices'][n];\n  const p1 = [].concat(INTRO1[r.name] || `${list(r.focus)} ${r.focus.length > 1 ? 'are the areas' : 'is the area'} where a small change could make the biggest difference.`);\n  const pace = { 'Something in between': \"you're looking for a pace that feels steady without being too gentle\", 'Small, easy steps': \"you'd like to start with small, easy steps\", 'A bigger challenge': \"you've asked for a bigger challenge\" }[r.pace] || \"you'd like a pace that suits you\";\n  const p2 = `You have around ${r.timeTxt} a week to dedicate to your wellbeing, and ${pace}. We've used your answers to shape a plan around what you already do, where you could make progress, and what feels realistic for your life.`;\n  const p3 = `Your Good Span starts with ${num}. Small enough to begin, meaningful enough to build on.`;\n  return [...p1, p2, p3];\n}\n\n// Starting Position: one specific observation per dimension, from each member's own answers\nconst SPC = {\n  'Inês': {\n    Movement: ['Your focus', \"You're active three days a week, about 120 minutes in all, with strength training twice a week.\"],\n    Nutrition: ['Cooking at home', 'You cook 3 to 5 main meals a week at home and already eat 3–4 portions of vegetables and fruit a day.'],\n    Sleep: ['Well supported', 'You sleep 7–8 hours, keep a regular bedtime and wake time, and your bedroom is cool, dark and quiet.'],\n    Mind: ['Habits to protect', 'You spend 2–3 hours a week in nature and make time for things you enjoy, away from work.'],\n    Connection: ['Staying connected', 'You see friends or family every week and take part in a group or class 2–3 times a month.'],\n    Prevention: ['Positive foundations', \"You don't smoke, keep alcohol to 1–2 drinks a few times a month and had your blood pressure checked in the past year.\"]\n  },\n  'Marta': {\n    Mind: ['Your focus', \"You'd like support with managing stress and difficult emotions, and you already make time for hobbies and time in nature.\"],\n    Movement: ['Your focus', \"You're active three days a week, about 120 minutes in all, with strength training twice a week.\"],\n    Nutrition: ['Eating well', 'You eat 3–4 portions of vegetables and fruit a day, with protein in two of your main meals.'],\n    Sleep: ['Well supported', 'You sleep 7–8 hours, get morning daylight and finish your caffeine by early afternoon.'],\n    Connection: ['Staying connected', 'You share meals with others most weeks and take time to really listen when you talk.'],\n    Prevention: ['Positive foundations', \"You don't smoke, keep alcohol to a few drinks a month and had your blood pressure checked in the past year.\"]\n  },\n  'Hugo': {\n    Sleep: ['Your focus', 'You usually sleep 6–7 hours, and on several nights a week it takes you a long time to fall asleep.'],\n    Nutrition: ['Your focus', 'You cook most of your meals at home, but usually eat around 1–2 portions of vegetables and fruit a day.'],\n    Movement: ['On hold for now', \"You'd like to improve your fitness. Because of the chest discomfort you mentioned, increasing your activity waits until you've spoken to a doctor.\"],\n    Mind: ['Habits to protect', 'You spend 2–3 hours a week in nature and keep social media to under an hour a day.'],\n    Connection: ['Staying connected', 'You see friends or family every week and take part in a group or class 2–3 times a month.'],\n    Prevention: ['Positive foundations', \"You don't smoke, and your blood pressure was checked in the past year.\"]\n  }\n};\n\n// photo of the member's first focus area, from the website's pillar images\nconst IMG = __IMG__;\nconst NOTICE = { Marta: { title: 'Something worth discussing', text: \"You told us you've felt anxious or low on most days over the last two weeks. The practices in your Good Span can support you day to day, but they aren't a treatment. When feelings like these last, it's worth talking to your GP or another health professional, alongside your Good Span.\" } };\n// photo chosen per member where it differs from the first focus area\nconst PHOTO = { Hugo: 'Stretch' };\nconst ALT = { Nutrition: 'Hands stirring a steaming pot of rice.', Sleep: 'A woman stretching forward on a green yoga mat in warm morning light.', Movement: 'A small group doing yoga together on the grass in a Lisbon park.', Mind: 'A textile artist smiling as she stitches red thread at her table.', Connection: 'Two women of different generations walking arm in arm at golden hour, smiling at each other.', Prevention: 'A hand brushing through herbs in a rooftop garden.', Stretch: 'A woman stretching forward on a green mat in warm morning light.' };\n// section 3: why each focus, explained once; what already goes well in it\nconst MOVE = { p: [\"You already move regularly and include strength training in your week. Your answers suggest that building up your aerobic activity is a practical next step.\", \"You're currently doing around 120 minutes of moderate activity a week. The general guideline is at least 150 minutes, so you're already close. A little more movement could help you build towards that benchmark over time.\"], well: ['Getting 8,000–10,000 steps on a typical day.', 'Making time for strength training twice a week.', 'Staying active outdoors and at home.'] };\nconst FOC = {\n  'Inês': { Movement: MOVE },\n  'Marta': {\n    Mind: { p: [\"You'd like support with managing stress and difficult emotions, and you already make time for things you enjoy.\", \"Over the last two weeks, you've often felt anxious or low. Your plan starts with two small, everyday practices that build on what you already enjoy, and support you day to day.\"], well: ['Making time for hobbies and activities you enjoy.', 'Taking time away from work.', 'Spending 2–3 hours a week in nature.'] },\n    Movement: { p: [MOVE.p[0], \"You're currently doing around 120 minutes of moderate activity a week, close to the 150-minute guideline. Because your priority is your mental wellbeing, this joins your plan in month 3, once your first practices feel settled.\"], well: MOVE.well }\n  },\n  'Hugo': {\n    Sleep: { p: ['You already have a regular routine and a bedroom set up for sleep. What your answers point to is the time you give sleep, and how easily you fall asleep.', 'You usually sleep 6–7 hours a night, and on 3 or more nights a week it takes you a long time to fall asleep. The general guideline is 7 or more hours for adults.'], well: ['Getting daylight in the morning.', 'Keeping a regular bedtime and wake time.', 'Keeping your bedroom cool, dark and quiet.'] },\n    Nutrition: { p: ['You cook most of your meals at home and already include protein and whole grains. The gap is vegetables and fruit.', \"You're currently eating around 1–2 portions a day. The general guideline is at least 5, so a little more each day could help you build towards that over time.\"], well: ['Cooking 3 to 5 main meals a week at home.', 'Including protein in two of your main meals.', 'Keeping sugary drinks, processed foods and added salt occasional.'] }\n  }\n};\n\n// sections 4–7: practice cards are action-first. 'min' is the extra time each one adds, and section 6 adds these up.\nconst NUMW = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];\nconst AEROBIC = { t: 'Build your aerobic activity', a: 'Add about 30 minutes of moderate activity to your week.', min: 30, time: 'About 30 minutes a week, on top of the 120 you already do. That brings you to the 150-minute guideline.', make: ['For example, a 10-minute brisk walk on three days, or a few extra minutes in sessions you already do.', 'Use the talk test to gauge intensity: you should be breathing more heavily while still being able to talk.'], why: 'The World Health Organization recommends at least 150 minutes of moderate activity a week for adults, based on its links with heart health and long-term wellbeing.' };\nconst PRC = {\n  'Inês': [AEROBIC],\n  'Marta': [\n    { t: 'Look at it another way', a: 'Once a week, look at an upsetting moment from a different angle.', min: 5, tl: '5 min a week (once a week)', time: 'About 5 minutes, once a week.', make: [\"When something upsetting happens and you've settled a little, ask yourself what is within your control right now, and what other ways you could see it.\", 'You can do this in your head, on a walk or while listening to music, whichever suits you.'], why: 'A large review of studies found that changing how you think about a situation helped people manage how they felt in the moment, more than trying to push feelings away.' },\n    { t: 'Savour the good moments', a: 'Once a day, pause to savour a pleasant moment as it happens.', min: 10, tl: 'about 10 min a week (1–2 min a day)', time: '1–2 minutes a day, about 10 minutes a week.', make: ['When something enjoyable happens, like a good cup of tea, a favourite song or sunshine on your face, slow down, notice the details and let yourself enjoy it a little longer.', 'It fits easily into the quiet time you already like to have on your own.'], why: 'A review of trials found that savouring exercises increased positive emotions and wellbeing. It builds on time you already make for things you enjoy.' }],\n  'Hugo': [\n    { t: 'Protect your sleep window', a: 'Allow 7 hours or more for sleep on at least 6 nights a week.', min: 0, time: 'No extra activity time. It may mean going to bed a little earlier.', make: ['Work back from the time you need to get up, and set a time to start winding down.', 'Keep a simple sleep diary, or use a wearable, and notice how rested you feel during the day.'], why: 'You usually sleep 6–7 hours. Sleep experts recommend 7 or more hours a night for adults, and you already keep a regular bedtime and wake time, so this adjusts a routine you have.' },\n    { t: 'More vegetables and fruit', a: 'Add vegetables or fruit to one more meal every day.', min: 0, time: 'No extra time: it changes what goes into meals you already cook.', make: ['Start with one extra portion. Once that feels normal, add another.', 'You enjoy cooking, so this can be a chance to try a new vegetable or recipe each week.'], why: 'You eat around 1–2 portions of vegetables and fruit a day, and 5 is the general guideline. Large reviews link eating more of them with a lower risk of heart disease.' }]\n};\nconst pmins = r => (PRC[r.name] || []).reduce((t, c) => t + (c.min || 0), 0) || r.mins;\n// designed to fit your life: one compact block under the practices\nfunction fitBlock(r) {\n  const n = r.practices.length, cap = { 45: '45 minutes', 60: 'one hour', 120: 'two hours', 240: 'four hours' }[r.lower] || r.lower + ' minutes';\n  const pace = { 'Something in between': 'steady pace', 'Small, easy steps': 'small, easy steps', 'A bigger challenge': r.safety ? 'a bigger challenge, once it is safe' : 'a bigger challenge' }[r.pace] || 'your pace';\n  const m = pmins(r);\n  return `<div class=\"fitb\"><h3>Designed to fit your life<\/h3>\n    <p class=\"fitline\">${m ? `${m} additional minutes a week to start` : 'No extra activity time to start'} · ${esc(pace)} · ${NUMW[n]} initial practice${n === 1 ? '' : 's'}<\/p>\n    ${(PRC[r.name] || []).length > 1 ? `<ul class=\"tbr\">${PRC[r.name].map(c => `<li><span>${esc(c.t)}<\/span><b>${c.tl || (c.min ? c.min + ' min a week' : 'no extra time')}<\/b><\/li>`).join('')}<\/ul>` : ''}\n    <ul class=\"fit3\"><li><b>Your time, respected.<\/b> We plan for no more than ${cap} a week, the lower end of what you told us you have.<\/li><li><b>Built around what you already do.<\/b> Nothing asks you to do more of what is already going well.<\/li><li><b>Adapted as you progress.<\/b> New practices join one at a time, and we adjust or swap them to keep within your time.<\/li><\/ul><\/div>`;\n}\n// next steps: the same names and months in the journey\nconst whenOf = (r, fam) => r.add2.includes(fam) ? 'Month 2' : r.add3.includes(fam) ? 'Month 3' : 'Months 4–5';\n\nconst NXT = {\n  'Walking after meals': 'Add a 10-minute walk after one of your main meals, five days a week. A simple way to bring more movement into the day.',\n  'Balance': 'Introduce balance-challenging exercises three times a week, starting with about 11 minutes. Build this into your routine as you feel ready.',\n  'Weekly cardio': 'Add about 30 minutes of moderate activity a week, bringing you to the 150-minute guideline. You are already close.',\n  'Self-compassion': 'Take a short self-compassion break when something feels hard, for about 5 minutes on three days a week. A kind way to respond to difficult moments.',\n  'Problem-solving steps': \"Pick one problem that's on your mind and think through at least three ways to tackle it, for about 10 minutes once a week. A practical way to turn worry into a next step.\",\n  'Stretching': 'Add 10 minutes of mobility or stretching work, three times a week. A simple way to maintain mobility and range of motion.',\n  'Slow breathing to wind down': 'Practise slow breathing for 5 minutes as part of your wind-down, five nights a week. A simple way to help your body settle before sleep.',\n  'Bedtime to-do list': \"Spend 5 minutes before bed writing a to-do list for the next few days, so tomorrow's tasks aren't on your mind.\",\n  'Beans and lentils': 'Include beans, lentils or chickpeas in two meals a week. An easy way to add variety to the meals you already cook.',\n  'Daily eating window': 'Keep your eating within a 10-hour window on at least five days a week. Build this in once your first practices feel settled.'\n};\nconst NAMEL = { 'Walking after meals': 'walking after meals', 'Balance': 'balance', 'Self-compassion': 'self-compassion', 'Stretching': 'stretching', 'Problem-solving steps': 'problem-solving steps', 'Slow breathing to wind down': 'slow breathing to wind down', 'Beans and lentils': 'beans and lentils', 'Bedtime to-do list': 'a bedtime to-do list' };\nconst DIR = {\n  'Structured Cardio': 'Structured cardio could help you continue building aerobic fitness through regular sessions and intervals.',\n  'Cognitive & Emotional Regulation': 'Cognitive and emotional regulation could give you more ways to handle stress and emotions, from reframing and self-talk to self-compassion and problem-solving.',\n  'Rest & Enjoyment': 'Rest and enjoyment could help you make more room for nature, breaks, music and the activities you enjoy.',\n  'Sleep Duration & Support': 'Sleep duration and support could help you keep getting enough sleep, night after night.',\n  'Plant-Rich Eating': 'Plant-rich eating could help you add more vegetables, fruit, whole grains, beans and lentils to your week.'\n};\n// short citation for \"What supports this\", and full references with their DOI as a link\nconst cite = r => { const au = r.split(/\\(\\d{4}\\)/)[0], parts = au.split(/\\.,\\s+/).map(x => x.replace(/^&\\s*/, '').split(',')[0].trim()).filter(Boolean), yr = (r.match(/\\((\\d{4})\\)/) || [])[1] || ''; const who = parts.length > 2 || /\\.\\s\\.\\s\\./.test(au) ? parts[0] + ' et al.' : parts.join(' & '); const t = (r.split(/\\(\\d{4}\\)\\.\\s*/)[1] || '').split(/\\.\\s/)[0]; return `${who}, ${yr}${t ? '. ' + t : ''}`; };\nconst linkDoi = t => esc(t).replace(/(https?:\\/\\/[^\\s<]+[^\\s<.,)])/g, '<a href=\"$1\" target=\"_blank\" rel=\"noopener\">$1<\/a>');\nconst GL = { focus: 'Focus now', improve: 'Worth improving', well: 'Going well' };\n// the Starting Position as a map: the member at the centre, six dimensions around them in a fixed order,\n// each linked to the centre. Focus now = large filled circle and solid line; worth improving = dashed; going well = fine outline and dotted line.\nfunction mapSvg(r) {\n  // spider web: three rings (outer = going well, middle = worth improving, inner = focus now); the shape dips where to focus\n  const W = 780, H = 580, cx = W / 2, cy = H / 2 + 4, R = 190;\n  const fill = { Nutrition: '#FE600C', Sleep: '#FFFFFF', Movement: '#F5A4C2', Mind: '#CB863A', Connection: '#4D2831', Prevention: '#000000' };\n  const lv = { well: 1, improve: .66, focus: .36 };\n  const ang = i => (-90 + i * 60) * Math.PI / 180, P = (i, k) => [cx + R * k * Math.cos(ang(i)), cy + R * k * Math.sin(ang(i))];\n  const hex = k => AREAS.map((a, i) => P(i, k).map(v => v.toFixed(1)).join(',')).join(' ');\n  const pts = AREAS.map((a, i) => P(i, lv[r.groups[a]]));\n  const rings = [[1, 'stroke-width=\"1.4\"'], [.66, 'stroke-width=\"1.3\" stroke-dasharray=\"7 6\"'], [.36, 'stroke-width=\"1.6\" stroke-dasharray=\"1 6\" stroke-linecap=\"round\"']]\n    .map(([k, st]) => `<polygon points=\"${hex(k)}\" fill=\"none\" stroke=\"#4D2831\" stroke-opacity=\".55\" ${st}/>`).join('');\n  const spokes = AREAS.map((a, i) => { const [x, y] = P(i, 1); return `<line x1=\"${cx}\" y1=\"${cy}\" x2=\"${x.toFixed(1)}\" y2=\"${y.toFixed(1)}\" stroke=\"#4D2831\" stroke-opacity=\".3\" stroke-width=\"1\"/>`; }).join('');\n  const ringLab = [[1, 'Going well'], [.66, 'Worth improving'], [.36, 'Focus now']].map(([k, t]) => `<text x=\"${(cx + 6).toFixed(1)}\" y=\"${(cy - R * k + 16).toFixed(1)}\" class=\"rl\">${t}<\/text>`).join('');\n  const shape = `<polygon points=\"${pts.map(p => p.map(v => v.toFixed(1)).join(',')).join(' ')}\" fill=\"#D1E6E9\" fill-opacity=\".85\" stroke=\"#4D2831\" stroke-width=\"2\" stroke-linejoin=\"round\"/>`;\n  const dots = AREAS.map((a, i) => { const [x, y] = pts[i], g = r.groups[a]; return `<circle cx=\"${x.toFixed(1)}\" cy=\"${y.toFixed(1)}\" r=\"${g === 'focus' ? 13 : 9}\" fill=\"${fill[a]}\" stroke=\"#4D2831\" stroke-width=\"1.4\"/>`; }).join('');\n  const labs = AREAS.map((a, i) => { const [x, y] = P(i, 1.2), c = Math.cos(ang(i)), anc = Math.abs(c) < .2 ? 'middle' : c > 0 ? 'start' : 'end', dy = Math.sin(ang(i)) < -.5 ? -12 : Math.sin(ang(i)) > .5 ? 14 : 0, g = r.groups[a];\n    return `<g class=\"ml ml-${g}\"><text x=\"${x.toFixed(1)}\" y=\"${(y + dy).toFixed(1)}\" text-anchor=\"${anc}\" class=\"mt\">${a.toUpperCase()}<\/text><text x=\"${x.toFixed(1)}\" y=\"${(y + dy + 22).toFixed(1)}\" text-anchor=\"${anc}\" class=\"ms\">${GL[g]}<\/text><\/g>`; }).join('');\n  return `<svg class=\"mapsvg\" viewBox=\"0 0 ${W} ${H}\" role=\"img\" aria-label=\"Your six dimensions, shown as a web\">${rings}${spokes}${shape}${dots}${labs}<\/svg>`;\n}\n// one ring per pillar, drawn in the identity's line language: filled = focus now, dotted = worth improving, fine solid line = going well\nfunction ring(a, g, mini) {\n  const fill = { Nutrition: '#FE600C', Sleep: '#FFFFFF', Movement: '#F5A4C2', Mind: '#CB863A', Connection: '#4D2831', Prevention: '#000000' }[a];\n  const v = mini ? 'viewBox=\"0 0 24 24\" class=\"mini\"' : 'viewBox=\"0 0 120 120\"', c = mini ? 12 : 60, R = mini ? 10 : 54, w = mini ? 1.2 : 1.5;\n  if (g === 'focus') return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"${mini ? '#4D2831' : fill}\" stroke=\"#4D2831\" stroke-width=\"${w}\"/><\/svg>`;\n  if (g === 'improve') return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"${w + .3}\" stroke-dasharray=\"${mini ? '1 2.4' : '1.5 5.5'}\" stroke-linecap=\"round\"/><\/svg>`;\n  return `<svg ${v} aria-hidden=\"true\"><circle cx=\"${c}\" cy=\"${c}\" r=\"${R}\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"${w}\"/><\/svg>`;\n}\n\n// generated members bring their own copy and timings\nD.filter(r => r.gen).forEach(r => { INTRO1[r.name] = r.intro1; SPC[r.name] = r.spc; FOC[r.name] = r.foc; PRC[r.name] = r.prc;\n  if (r.notice) NOTICE[r.name] = r.notice; else delete NOTICE[r.name]; delete PHOTO[r.name];\n  [...r.steps.m2, ...r.steps.m3, ...r.steps.later].forEach(x => { STEPMIN[x.fam] = x.min || 0; }); });\nif (GEN) Object.keys(NXT).forEach(k => delete NXT[k]);\nconst ORDER = r => [...(r.gen ? r.focus : []).filter(a => r.groups[a] === 'focus'), ...AREAS.filter(a => r.groups[a] === 'focus' && !(r.gen && r.focus.includes(a))), ...AREAS.filter(a => r.groups[a] === 'improve'), ...AREAS.filter(a => r.groups[a] === 'well')];\nconst S = [\n  // opening: their Good Span, a short portrait, and the Starting Position as one strip of six\n  r => { const op = openingOf(r); return `<div class=\"hero\"><div class=\"htext\">\n    <div class=\"ht\"><h1>Your Good Span<\/h1><p class=\"kicker hk\">${esc(r.name)} · ${esc(r.date || '12 October 2026')}<\/p><p class=\"hsub hlead\">${esc(op.lead)}<\/p><\/div>\n    <div class=\"hls\">${op.paras.map(t => `<p class=\"hl\">${esc(t)}<\/p>`).join('')}<\/div>\n    <\/div>${(() => { const k = PHOTO[r.name] || r.focus[0]; return IMG[k] ? `<figure class=\"hfig\"><img src=\"${IMG[k]}\" alt=\"${esc(ALT[k])}\"><figcaption><span class=\"chip p-${r.focus[0]}\">${esc(r.focus[0])}<\/span><\/figcaption><\/figure>` : ''; })()}\n  <\/div>\n    ${NOTICE[r.name] ? `<div class=\"check check-top notice\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"15\" fill=\"#CB863A\"/><circle cx=\"24\" cy=\"24\" r=\"20\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\" stroke-dasharray=\"2 3\"/><\/svg><div><h3>${esc(NOTICE[r.name].title)}<\/h3><p style=\"margin-top:6px\">${esc(NOTICE[r.name].text)}<\/p><\/div><\/div>` : ''}\n    ${r.safety ? `<div class=\"check check-top\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"20\" cy=\"24\" r=\"14\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\"/><circle cx=\"28\" cy=\"24\" r=\"14\" fill=\"none\" stroke=\"#4D2831\" stroke-width=\"1.2\" stroke-dasharray=\"2 3\"/><\/svg><div><h3>${esc(r.safety.title)}<\/h3><p style=\"margin-top:6px\">${esc(r.safety.text)}<\/p><\/div><\/div>` : ''}`; },\n\n  // Your Starting Position: one label and a short reading per pillar, in the order of the strip\n  r => `<h1>Your Starting Position<\/h1>\n    <p class=\"secsub\">Your personal longevity map<\/p>\n    <p class=\"lead\">Here is what is already supporting your wellbeing, and where a small change could help you move forward.<\/p>\n    <figure class=\"map\" aria-label=\"Your Starting Position across the six pillars\">\n      ${mapSvg(r)}\n      <ul class=\"sr-only\">${AREAS.map(a => `<li>${a}: ${GL[r.groups[a]]}<\/li>`).join('')}<\/ul>\n      <figcaption class=\"mlegend\"><span><svg class=\"mini\" viewBox=\"0 0 34 14\" aria-hidden=\"true\"><line x1=\"1\" y1=\"7\" x2=\"33\" y2=\"7\" stroke=\"#4D2831\" stroke-width=\"1.6\"/><\/svg> Outer ring: going well<\/span><span><svg class=\"mini\" viewBox=\"0 0 34 14\" aria-hidden=\"true\"><line x1=\"1\" y1=\"7\" x2=\"33\" y2=\"7\" stroke=\"#4D2831\" stroke-width=\"1.6\" stroke-dasharray=\"6 4\"/><\/svg> Middle: worth improving<\/span><span><svg class=\"mini\" viewBox=\"0 0 34 14\" aria-hidden=\"true\"><line x1=\"1\" y1=\"7\" x2=\"33\" y2=\"7\" stroke=\"#4D2831\" stroke-width=\"1.8\" stroke-dasharray=\"1 4\" stroke-linecap=\"round\"/><\/svg> Inner: focus now<\/span><\/figcaption>\n    <\/figure>\n    <div class=\"brief\">${ORDER(r).map(a => { const [lab, txt] = (SPC[r.name] || {})[a] || [GL[r.groups[a]], r.prof.pillars[a]]; return `<div class=\"bp a-${a} g-${r.groups[a]}\"><div class=\"bh\"><h3>${a}<\/h3><span class=\"tag t-${r.groups[a]}\">${esc(lab)}<\/span><\/div><p>${esc(txt)}<\/p><\/div>`; }).join('')}<\/div>`,\n\n  r => `<h1>Where a small change could go a long way<\/h1>\n    <div class=\"fstack\">${r.focus.map(a => { const f = (FOC[r.name] || {})[a] || { p: r.reasons[a] || [], well: [] }; return `<div class=\"fcard fwide a-${a}\">${ARC([['100%', '100%', 90, 'currentColor', 'dash', 1.2]])}\n      <div class=\"fmain\"><span class=\"chip\">Your focus<\/span><span class=\"fh\">${a}<\/span>${f.p.map(t => `<p>${esc(t)}<\/p>`).join('')}<\/div>\n      ${f.well.length ? `<div class=\"fwell\"><h3>What you're already doing well<\/h3><ul>${f.well.map(t => `<li>${esc(t)}<\/li>`).join('')}<\/ul><\/div>` : ''}<\/div>`; }).join('')}<\/div>\n    <p class=\"lead\">We'll build on these habits instead of asking you to start from scratch.<\/p>`,\n\n  // section 4: first practices, each with what to do, how to make it work and why\n  r => `<h1>${r.practices.length === 1 ? 'Your first practice' : `Your first ${NUMW[r.practices.length]} practices`}<\/h1>\n    <p class=\"lead\">These are your first steps for the month ahead, chosen around what matters to you and the time you have.<\/p>\n    <div class=\"prs\">${r.practices.map((x, i) => { const c = (PRC[r.name] || [])[i] || { t: x.fam, a: x.action + ' ' + x.freq + '.', make: [x.start], why: x.why }; return `<article class=\"pr a-${x.area}\"><div class=\"hd\">${ARC([['100%', '100%', 120, 'currentColor', i % 2 ? 'dot' : 'dash', 1.5]])}<span class=\"chip\">${esc(x.area)}<\/span><span class=\"pnum\">${String(i + 1).padStart(2, '0')} · ${esc(c.t)}<\/span>\n      <p class=\"act\">${esc(c.a)}<\/p><\/div><div class=\"bd\">\n      <dl>${c.time ? `<dt>Time<\/dt><dd><p>${esc(c.time)}<\/p><\/dd>` : ''}<dt>Make it work for you<\/dt><dd>${c.make.map(t => `<p>${esc(t)}<\/p>`).join('')}<\/dd>${c.why ? `<dt>Why this practice<\/dt><dd><p>${esc(c.why)}<\/p><\/dd>` : ''}<\/dl>\n      ${(x.refs || []).length ? `<details><summary>What supports this<\/summary><ul class=\"srcs\">${x.refs.map(t => `<li>${esc(cite(t))}.<\/li>`).join('')}<\/ul><p>The full list of references is <a href=\"#references\">at the bottom of this page<\/a>.<\/p><\/details>` : ''}<\/div><\/article>`; }).join('')}<\/div>\n    ${fitBlock(r)}\n    ${r.found.length ? `<div class=\"later\"><p class=\"kicker\">Optional everyday habits<\/p><ul>${r.found.map(f => `<li>${esc(f.text)} <span class=\"note\">${esc(f.why)}<\/span><\/li>`).join('')}<\/ul><\/div>` : ''}`,\n\n  // the six-month journey, with the next practices and the weekly time at each step\n  r => { const st = r.steps || { m2: [], m3: [], later: [] }; const add = a => a.reduce((t, x) => t + (STEPMIN[x.fam] || 0), 0);\n    const t1 = pmins(r), t2 = t1 + add(st.m2), t3 = t2 + add(st.m3), mins = v => v ? `About ${v} minutes a week in all` : 'Still no extra activity time';\n    const item = x => `<li class=\"js\"><span class=\"chip p-${x.area}\">${esc(x.area)}<\/span><b>${esc(STEPNAME[x.fam] || x.fam)}<\/b><span>${esc(NXT[x.fam] || (x.action + ' ' + x.freq + '.'))}<\/span><\/li>`;\n    const t = r.themes.length;\n    return `<h1>Your six-month journey<\/h1>\n    <p class=\"lead\">Your Good Span is a starting point, not a fixed prescription. Each month, you'll reflect on what's working, adapt what isn't and decide what comes next. New practices join one at a time, once the earlier ones feel familiar.<\/p>\n    <div class=\"roadwrap\">${ARC([['104%', '-22%', 150, '#4D2831', 'solid', 1.5], ['-3%', '112%', 110, '#FFFFFF', 'dot', 2]])}<ol class=\"road vroad\">\n      <li class=\"now\"><span class=\"pt\"><\/span><span class=\"what\">Month 1 · Begin<\/span><p>Get familiar with ${r.practices.length === 1 ? 'your first practice' : `your first ${NUMW[r.practices.length]} practices`} and find ways to make ${r.practices.length === 1 ? 'it' : 'them'} part of your week.<\/p><p class=\"jt\">${t1 ? `About ${t1} minutes a week` : 'No extra activity time'}<\/p><\/li>\n      <li class=\"mid\"><span class=\"pt\"><\/span><span class=\"what\">Month 2 · Build<\/span><p>Keep the practices that are working${st.m2.length ? ' and, when you feel ready, add:' : '.'}<\/p>${st.m2.length ? `<ul class=\"jsl\">${st.m2.map(item).join('')}<\/ul><p class=\"jt\">${mins(t2)}<\/p>` : ''}<\/li>\n      <li class=\"mid\"><span class=\"pt\"><\/span><span class=\"what\">Month 3 · Refine<\/span><p>Review your progress and adjust the plan to fit your routines, priorities and experience${st.m3.length ? '. If it feels right, add:' : '.'}<\/p>${st.m3.length ? `<ul class=\"jsl\">${st.m3.map(item).join('')}<\/ul><p class=\"jt\">${mins(t3)}, within the ${esc(r.timeTxt)} you told us you have<\/p>` : ''}<\/li>\n      <li><span class=\"pt\"><\/span><span class=\"what\">Months 4–5 · Deepen<\/span><p>Explore the next practices in your focus areas, building on what you've learned so far${st.later.length ? `, such as ${list(st.later.map(x => `<b>${esc(STEPNAME[x.fam] || x.fam)}<\/b>`))}. Where time is tight, a new practice can replace one that is already a habit` : ''}.<\/p><\/li>\n      <li><span class=\"pt\"><\/span><span class=\"what\">Month 6 · Consolidate<\/span><p>Identify the habits that matter most to you and make them easier to sustain beyond the programme.<\/p><\/li>\n      <li class=\"end\"><span class=\"pt\"><\/span><span class=\"what\">After six months: Your New Position<\/span><p>Repeat your assessment to see how your habits, priorities and starting position have evolved. Review the results with your Pilot and decide what you want to focus on next.<\/p><\/li>\n    <\/ol>\n    <div class=\"later\"><p class=\"kicker\">${t === 1 ? 'One possible next direction' : NUMW[t].charAt(0).toUpperCase() + NUMW[t].slice(1) + ' possible next directions'}<\/p>${r.themes.map(x => `<p>${esc(DIR[x[1]] || x[1] + '. ' + x[2])}<\/p>`).join('')}<p>Or you can keep going with what's working. Maintaining a habit that supports your wellbeing is progress too.<\/p><\/div><\/div>`; },\n\n  // section 8: belonging, then the next step: meet your Pilot (before any choice of support)\n  r => `<div class=\"close\">${ARC([['102%', '0%', 160, '#D1E6E9', 'solid', 2], ['104%', '86%', 110, '#4D2831', 'dash', 1.5], ['88%', '108%', 64, '#F5A4C2', 'dot', 2]])}\n    <h2>Ready to make your Good Span part of everyday life?<\/h2>\n    <p class=\"belong\">Longevity is personal. It shouldn't be lonely.<\/p>\n    <p>This is your starting Good Span. It is personal to you, but the journey doesn't have to be solitary. Over the next six months, a Pilot works alongside you, and you'll be part of a community of members on the same journey.<\/p><\/div>\n    <div class=\"pilot\">${ARC([['102%', '-6%', 170, '#4D2831', 'solid', 1.5], ['104%', '70%', 110, '#FFFFFF', 'dash', 2]])}\n    <div class=\"pmain\"><h2 class=\"sh\">Your next step: meet your Pilot<\/h2>\n    <p>Book a short conversation to talk through your Starting Position and first practices, make sure they feel right for your life, and decide how much support you would like over the next six months.<\/p>\n    <div class=\"pcta\"><button class=\"btn pbtn\" type=\"button\">Book my Good Span Review<\/button><p class=\"pmeta\">20 minutes · online · no preparation needed<\/p><\/div><\/div>\n    <div class=\"pafter\"><p class=\"kicker\">In your Good Span Review<\/p><h3>Your Pilot will<\/h3>\n      <ul><li><b>Review your Starting Position<\/b><span>and your first practices with you.<\/span><\/li><li><b>Refine anything that doesn't fit<\/b><span>so the plan feels realistic for your life.<\/span><\/li><li><b>Answer your questions<\/b><span>about your Good Span and how it works.<\/span><\/li><li><b>Help you choose your support<\/b><span>Self, Core or Concierge, explained below.<\/span><\/li><\/ul><\/div>\n  <\/div>`,\n\n  // section 9: the support options, explained so they can be discussed with the Pilot (chosen after the Review, not here)\n  r => `<h1>Ways to continue after your Review<\/h1>\n    <p class=\"lead\">Your Pilot will help you decide which level of support suits you. Every membership includes the same foundations; the difference is how much individual support you want along the way.<\/p>\n    <div class=\"incl\"><h3>What's included in every membership<\/h3>\n      <ul>${[['Your personal longevity map', 'your Starting Position and personalised priorities.'], ['Practices chosen for you', `${NUMW[r.practices.length]} personalised practice${r.practices.length === 1 ? '' : 's'} to start, based on your assessment.`], ['A six-month plan', 'reviewed and adapted as you progress.'], ['A Pilot welcome conversation', 'review your Starting Position and refine your plan.'], ['Member App and Practice Journal', 'follow your practices and reflect on your progress.'], ['Monthly Longevity Live', 'join the session live or watch the replay.'], ['Member connections and gatherings', 'opportunities to learn and connect with others.'], ['Preferred member rates', 'access curated specialists, products and services at member rates.'], ['Your six-month review', 'repeat the assessment and review your New Position with your Pilot.']].map(([b, t]) => `<li><b>${esc(b)}:<\/b> ${esc(t)}<\/li>`).join('')}<\/ul><\/div>\n    <div class=\"tiers\">\n      <div class=\"tier t-Self\" data-t=\"Self\"><span class=\"ui\">Self<\/span><span class=\"price\">€19<small>/month<\/small><\/span><span class=\"pterm\">Six-month commitment<\/span><p class=\"tl\">Your plan, on your terms.<\/p>\n        <p>Follow your Good Span independently, with a Pilot welcome conversation to review your Starting Position and refine your plan.<\/p>\n        <p>Over your six months, use the Member App and Practice Journal to follow your practices and reflect on your progress.<\/p>\n        <div class=\"tfoot\"><p class=\"trial\">Prefer to try it first? A one-month trial is available for €25, without Pilot support.<\/p><\/div><\/div>\n      <div class=\"tier t-Core\" data-t=\"Core\"><span class=\"ui\">Core<\/span><span class=\"price\">€129<small>/month<\/small><\/span><span class=\"pterm\" aria-hidden=\"true\">&nbsp;<\/span><p class=\"tl\">Personal guidance to keep you moving forward.<\/p>\n        <p>Take the lead day to day, with a Pilot who follows your progress, helps you work through challenges and adapts your Good Span with you.<\/p>\n        <p>Your membership includes regular Pilot reviews, WhatsApp support between reviews and a quarterly €50 Refuel.<\/p><\/div>\n      <div class=\"tier t-C