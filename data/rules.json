{
  "version": "2026-10-02",
  "description": "Plan-building rules for The Good Span. Option IDs refer to data/assessment.json; family and theme IDs refer to data/practices.json. Rule codes (P3, P5…) match the Assessment mapping sheet and docs/RULES.md.",
  "constants": {
    "practices_per_month": 6,
    "detailed_months": 3,
    "focus_practices_per_focus_pillar": 2,
    "max_focus_pillars": 2,
    "themes_months_4_6": 4,
    "micro_minutes_per_week": 10,
    "time_flex": 1.25,
    "top_up_below_minutes": 45,
    "min_score_for_second_theme_slot": 40,
    "weekly_budget_minutes": {
      "about_45_60_minutes": 60,
      "1_2_hours": 120,
      "2_4_hours": 240,
      "more_than_4_hours": 300,
      "it_varies": 120
    },
    "pilot_checkin_if_not_done_or_changed_in_month_at_least": 2,
    "hygiene_min_priority_items": 4,
    "hygiene_max_priority_items": 8
  },
  "levels": [
    "gentle",
    "moderate",
    "deep"
  ],
  "conditions": {
    "_doc": "Each condition is derived from assessment answers (source 'assessment') or set by the Pilot at the pre-Span interview (source 'pilot'). Practices list the conditions that exclude them in exclude_if.",
    "pregnant_or_breastfeeding": {
      "source": "assessment",
      "when": {
        "q": "pregnant_or_breastfeeding",
        "is": "yes"
      },
      "note": "Treated as pregnancy (the more cautious set); the Pilot can relax for breastfeeding."
    },
    "diabetes": {
      "source": "assessment",
      "when": {
        "q": "health_conditions",
        "has": "diabetes"
      }
    },
    "kidney_disease": {
      "source": "assessment",
      "when": {
        "q": "health_conditions",
        "has": "kidney_disease"
      }
    },
    "exercise_warning_symptoms": {
      "source": "assessment",
      "when": {
        "q": "exercise_symptoms",
        "has_any": [
          "chest_pain",
          "breathless",
          "dizzy_or_fainting",
          "palpitations",
          "swollen_ankles",
          "calf_pain"
        ]
      }
    },
    "condition_and_inactive": {
      "source": "assessment",
      "when": {
        "all": [
          {
            "q": "health_conditions",
            "has_any": [
              "a_heart_condition",
              "diabetes",
              "kidney_disease"
            ]
          },
          {
            "computed": "weekly_activity_minutes",
            "lt": 60
          }
        ]
      }
    },
    "pain_or_injury": {
      "source": "assessment",
      "when": {
        "q": "move_considerations",
        "has_any": [
          "ongoing_pain",
          "a_recent_injury",
          "a_joint_or_mobility_limitation"
        ]
      }
    },
    "difficult_relationship_with_food": {
      "source": "assessment",
      "when": {
        "q": "eat_considerations",
        "has_any": [
          "a_difficult_relationship_with_food",
          "prefer_not_to_say"
        ]
      }
    },
    "nut_allergy": {
      "source": "assessment",
      "when": {
        "q": "eat_considerations",
        "has": "nut_allergy"
      }
    },
    "shift_work": {
      "source": "assessment",
      "when": {
        "q": "work_pattern",
        "is": "shift_work_including_nights"
      }
    },
    "early_waking": {
      "source": "assessment",
      "when": {
        "q": "sleep_problems",
        "has": "early_waking"
      }
    },
    "lives_alone": {
      "source": "assessment",
      "when": {
        "q": "household",
        "has": "i_live_alone"
      }
    },
    "no_social_media": {
      "source": "assessment",
      "when": {
        "q": "social_media_time",
        "is": "i_dont_use_social_media"
      }
    },
    "non_drinker": {
      "source": "pilot"
    },
    "higher_risk_drinking": {
      "source": "pilot"
    },
    "low_mood_flag": {
      "source": "pilot"
    },
    "fall_past_year": {
      "source": "pilot"
    }
  },
  "pilot_holds": {
    "_doc": "P11. Not offered until the Pilot releases them at the pre-Span interview (no mood or alcohol screen in v6).",
    "practice_ids": [
      "expressive_writing.moderate",
      "expressive_writing.deep",
      "alcohol_and_sleep.deep",
      "alcohol_intake.gentle",
      "alcohol_intake.moderate",
      "alcohol_intake.deep"
    ]
  },
  "equipment": {
    "_doc": "Practices with equipment_needed are offered only if the member exercises at a gym, studio or club.",
    "allowed_if": {
      "q": "move_places",
      "has_any": [
        "gym_or_studio",
        "sports_facility_or_club"
      ]
    }
  },
  "avoid_types": {
    "q": "avoid_types",
    "excludes": {
      "tracking_or_counting_what_i_eat": [
        "daily_eating_window.*",
        "plant_variety.moderate",
        "plant_variety.deep",
        "salt.deep",
        "reducing_sugar.deep",
        "protein_at_meals.deep"
      ],
      "using_apps_or_devices_to_track_things": [],
      "eating_windows_or_fasting": [
        "daily_eating_window.*"
      ],
      "meditation": [
        "meditation.*"
      ],
      "journalling_or_writing": [
        "expressive_writing.*",
        "three_good_things.*",
        "bedtime_to_do_list.*"
      ],
      "early_morning_activities": [
        "morning_daylight.deep"
      ],
      "touch": [
        "affectionate_touch.*"
      ]
    }
  },
  "sleep_sharing": {
    "_doc": "P9. Light-touch only, and only in a month that includes a Sleep practice.",
    "families": [
      "sharing_sleep_plans_with_others",
      "sharing_sleep_learnings_with_others",
      "celebrating_sleep_wins"
    ]
  },
  "level_setting": {
    "_doc": "Baseline answers → starting level for a family ('skip' = already at the top, don't offer). Families with no baseline start at the member's typical measured level in that pillar (median, max moderate), else gentle (P2).",
    "single": [
      {
        "q": "eat_vegetables_fruit",
        "family": "balanced_plate",
        "map": {
          "none": "gentle",
          "1_2_portions": "gentle",
          "3_4_portions": "moderate",
          "5_or_more_portions": "deep"
        }
      },
      {
        "q": "eat_protein_meals",
        "family": "protein_at_meals",
        "map": {
          "none": "gentle",
          "one": "gentle",
          "two": "moderate",
          "all_of_them": "deep"
        }
      },
      {
        "q": "eat_home_cooked",
        "family": "meal_planning_and_home_cooking",
        "map": {
          "fewer_than_3": "gentle",
          "3_5": "moderate",
          "more_than_5": "deep"
        }
      },
      {
        "q": "eating_before_bed",
        "family": "gap_between_eating_and_bed",
        "map": {
          "less_than_1_hour": "gentle",
          "1_2_hours": "moderate",
          "2_3_hours": "deep",
          "3_hours_or_more": "skip"
        }
      },
      {
        "q": "sleep_hours",
        "family": "enough_sleep",
        "map": {
          "less_than_5": "gentle",
          "5_6": "gentle",
          "6_7": "moderate",
          "7_8": "skip",
          "8_9": "skip",
          "more_than_9": "skip"
        }
      },
      {
        "q": "strength_days",
        "family": "strength_sessions",
        "map": {
          "0": "gentle",
          "1": "moderate",
          "2": "deep",
          "3_or_more": "deep"
        }
      },
      {
        "q": "sitting_hours",
        "family": "breaking_up_sitting",
        "map": {
          "less_than_6": "moderate",
          "6_8": "moderate",
          "8_10": "gentle",
          "more_than_10": "gentle"
        }
      },
      {
        "q": "steps",
        "family": "daily_steps",
        "map": {
          "fewer_than_5_000": "gentle",
          "5_000_7_999": "moderate",
          "8_000_9_999": "deep",
          "10_000_or_more": "skip"
        }
      },
      {
        "q": "nature_time",
        "family": "time_in_nature",
        "map": {
          "less_than_30_minutes": "gentle",
          "30_minutes_to_2_hours": "moderate",
          "2_to_3_hours": "deep",
          "more_than_3_hours": "skip"
        }
      },
      {
        "q": "social_media_time",
        "family": "social_media_limits",
        "map": {
          "more_than_2_hours": "gentle",
          "1_2_hours": "moderate",
          "30_60_minutes": "deep",
          "less_than_30_minutes": "skip"
        }
      }
    ],
    "grid": [
      {
        "q": "eat_frequency",
        "row": "whole_grains",
        "family": "whole_grains",
        "map": {
          "rarely_or_never": "gentle",
          "1_2_days_week": "gentle",
          "3_5_days_week": "moderate",
          "6_7_days_week": "deep"
        }
      },
      {
        "q": "eat_frequency",
        "row": "beans_lentils",
        "family": "beans_and_lentils",
        "map": {
          "rarely_or_never": "gentle",
          "1_2_days_week": "gentle",
          "3_5_days_week": "moderate",
          "6_7_days_week": "deep"
        }
      },
      {
        "q": "eat_frequency",
        "row": "nuts",
        "family": "nuts",
        "map": {
          "rarely_or_never": "gentle",
          "1_2_days_week": "moderate",
          "3_5_days_week": "deep",
          "6_7_days_week": "skip"
        }
      },
      {
        "q": "eat_frequency",
        "row": "sugary_drinks",
        "family": "reducing_sugar",
        "map": {
          "6_7_days_week": "gentle",
          "3_5_days_week": "gentle",
          "1_2_days_week": "moderate",
          "rarely_or_never": "deep"
        }
      },
      {
        "q": "eat_frequency",
        "row": "processed_foods",
        "family": "less_processed_food",
        "map": {
          "6_7_days_week": "gentle",
          "3_5_days_week": "gentle",
          "1_2_days_week": "moderate",
          "rarely_or_never": "deep"
        }
      },
      {
        "q": "eat_frequency",
        "row": "adding_salt",
        "family": "salt",
        "map": {
          "6_7_days_week": "gentle",
          "3_5_days_week": "gentle",
          "1_2_days_week": "moderate",
          "rarely_or_never": "deep"
        }
      },
      {
        "q": "social_contact",
        "row": "phone_or_video",
        "family": "calling_instead_of_texting",
        "map": {
          "never": "gentle",
          "once": "gentle",
          "2_3_times": "moderate",
          "weekly_or_more": "deep"
        }
      },
      {
        "q": "social_contact",
        "row": "meet_in_person",
        "family": "shared_meals",
        "map": {
          "never": "gentle",
          "once": "gentle",
          "2_3_times": "moderate",
          "weekly_or_more": "deep"
        }
      },
      {
        "q": "social_contact",
        "row": "group_club_class",
        "family": "group_membership",
        "map": {
          "never": "gentle",
          "once": "gentle",
          "2_3_times": "moderate",
          "weekly_or_more": "deep"
        }
      },
      {
        "q": "social_contact",
        "row": "volunteer",
        "family": "volunteering",
        "map": {
          "never": "gentle",
          "once": "gentle",
          "2_3_times": "moderate",
          "weekly_or_more": "deep"
        }
      }
    ],
    "computed": [
      {
        "name": "weekly_activity_minutes",
        "formula": "activity_days × activity_minutes (150 or more = 150; 0 days = 0)",
        "family": "building_up_cardio",
        "bands": [
          {
            "lt": 30,
            "level": "gentle"
          },
          {
            "lt": 60,
            "level": "moderate"
          },
          {
            "lt": 100,
            "level": "deep"
          },
          {
            "gte": 100,
            "level": "skip"
          }
        ]
      },
      {
        "name": "weekly_activity_minutes",
        "family": "weekly_cardio",
        "bands": [
          {
            "lt": 100,
            "level": "skip"
          },
          {
            "lt": 150,
            "level": "gentle"
          },
          {
            "lt": 300,
            "level": "moderate"
          },
          {
            "gte": 300,
            "level": "deep"
          }
        ]
      }
    ]
  },
