  "scoring": {
    "_doc": "P5. Score per family; highest first. Ties: evidence fit (Direct 3, Reasonable 2, Indirect 1), then evidence strength (guideline or SR+MA 3, SR 2, other 1), then fewer minutes, then family id.",
    "top_goal": 100,
    "other_goal": 40,
    "sleep_disruptor": 40,
    "sleep_problem": 15,
    "insomnia_pattern": 30,
    "barrier": 10,
    "preference": 8,
    "work_from_home": 10,
    "tried_not_helped": -30,
    "age_60_plus_balance": 20,
    "room_to_improve": {
      "gentle": 20,
      "moderate": 10,
      "deep": 4,
      "no_baseline": 6,
      "skip": -100
    }
  },
  "focus": {
    "_doc": "Up to 2 focus pillars from the focus question. 'I'm not sure yet': suggest the 2 pillars with the highest average room to improve across their own baseline questions (+10 per goal chosen), ties in pillar order eat, sleep, move, mind, connect."
  },
  "monthly_plan": {
    "_doc": "P12. Months 1–3: six practices. Two focus pillars: 2 each + 2 light-touch rotating through the other 3 pillars. One focus pillar: 2 + 4 light-touch (one per other pillar). The first focus practice in each pillar matches its top goal; the second comes from a different theme when one scores 40+. Light-touch practices start at gentle (or the level already done).",
    "small_steps": {
      "q": "change_size",
      "option": "small_steps",
      "effect": "new practices start at gentle"
    },
    "bigger_challenge": {
      "q": "change_size",
      "option": "bigger_challenge",
      "effect": "new practices start one level above baseline"
    }
  },
  "progression": {
    "_doc": "P6. At each monthly check-in the member marks each practice.",
    "outcomes": {
      "done": "step up one level next month (after deep: next best-scoring family in that pillar)",
      "partly": "repeat the same practice",
      "not_yet": "step down one level, or switch family if already gentle",
      "not_for_me": "switch to the next best-scoring family in that pillar; do not offer the original again in months 1–3"
    },
    "next_family": {
      "_doc": "After the Deep level of a family is done, move to this family at its gentle level (if not excluded).",
      "building_up_cardio": "weekly_cardio"
    }
  },
  "time": {
    "_doc": "P7. Non-micro minutes should fit the weekly budget × time_flex. Over: hold step-ups, then set lower-priority practices to gentle or swap for a micro practice; keep the top-goal practice; still over → Pilot flag. Under top_up_below_minutes (and not small steps): step up a focus practice."
  },
  "themes": {
    "_doc": "P14. Four themes for months 4–6: one per focus pillar (two if one focus pillar) + two from other pillars. Each is the theme where the member's practices went best in months 1–3, else the best-scoring theme for that pillar. sharing_sleep_progress is never a theme.",
    "never_theme": [
      "sharing_sleep_progress"
    ]
  },
  "hygiene": {
    "_doc": "P13. 4–8 priority checklist items. Triggered items come first; if fewer than 4 trigger, fill from the rest of the checklist. Never-priority items stay off the list.",
    "triggers": {
      "dark_bedroom": {
        "all": [
          {
            "q": "sleep_disruptors",
            "has": "light_in_my_bedroom"
          },
          {
            "not": {
              "q": "sleep_habits",
              "row": "keep_my_bedroom_dark",
              "is": "i_do_this_now"
            }
          }
        ]
      },
      "bedroom_noise": {
        "all": [
          {
            "q": "sleep_disruptors",
            "has": "noise"
          },
          {
            "not": {
              "q": "sleep_habits",
              "row": "keep_bedroom_quiet",
              "is": "i_do_this_now"
            }
          }
        ]
      },
      "cool_bedroom": {
        "all": [
          {
            "q": "sleep_disruptors",
            "has": "bedroom_temperature"
          },
          {
            "not": {
              "q": "sleep_habits",
              "row": "keep_my_bedroom_cool",
              "is": "i_do_this_now"
            }
          }
        ]
      },
      "caffeine_timing": {
        "any": [
          {
            "q": "last_caffeine",
            "in": [
              "3_6pm",
              "after_6pm"
            ]
          },
          {
            "q": "sleep_disruptors",
            "has": "caffeine"
          }
        ]
      },
      "evening_light": {
        "all": [
          {
            "q": "sleep_disruptors",
            "has": "screens_or_technology"
          },
          {
            "not": {
              "q": "sleep_habits",
              "row": "dim_the_lights_in_the_evening",
              "is": "i_do_this_now"
            }
          }
        ]
      },
      "step_tracking": {
        "all": [
          {
            "q": "steps",
            "is": "i_dont_track_my_steps"
          },
          {
            "q": "move_goals",
            "has": "increase_everyday_movement"
          }
        ]
      },
      "music_and_enjoyment_in_exercise": {
        "q": "move_barriers",
        "has_any": [
          "lack_of_motivation",
          "i_find_exercise_boring"
        ]
      },
      "recovery": {
        "any": [
          {
            "computed": "weekly_activity_minutes",
            "gte": 150
          },
          {
            "q": "move_goals",
            "has": "improve_performance"
          }
        ]
      },
      "notifications": {
        "all": [
          {
            "q": "mind_goals",
            "has_any": [
              "focus_and_concentration",
              "less_phone_time"
            ]
          },
          {
            "not": {
              "q": "mind_routine",
              "has": "keeping_notifications_turned_off"
            }
          }
        ]
      },
      "warm_up": {
        "never_priority": true
      },
      "napping": {
        "never_priority": true
      }
    }
  },
  "pilot_flags": [
    {
      "id": "exercise_safety",
      "when": {
        "any": [
          {
            "condition": "exercise_warning_symptoms"
          },
          {
            "condition": "condition_and_inactive"
          }
        ]
      },
      "message": "Check with the family doctor before vigorous exercise; vigorous practices are excluded until cleared."
    },
    {
      "id": "snoring",
      "when": {
        "q": "snoring",
        "is": "yes"
      },
      "message": "Possible sleep apnoea: suggest a family doctor check."
    },
    {
      "id": "food_considerations",
      "when": {
        "q": "eat_considerations",
        "has_any": [
          "a_difficult_relationship_with_food",
          "food_health_condition",
          "other_food_allergy_or_intolerance",
          "something_else",
          "prefer_not_to_say"
        ]
      },
      "message": "Food considerations the rules cannot resolve."
    },
    {
      "id": "health_something_else",
      "when": {
        "q": "health_conditions",
        "has": "something_else"
      },
      "message": "Review the health condition the member described."
    },
    {
      "id": "pain_with_strength",
      "when": {
        "all": [
          {
            "condition": "pain_or_injury"
          },
          {
            "plan_includes_any": [
              "strength_sessions",
              "strength_volume",
              "balance"
            ]
          }
        ]
      },
      "message": "Pain or injury and the plan includes strength or balance: Pilot decides whether a specialist is needed."
    },
    {
      "id": "time_conflict",
      "when": {
        "plan": "over_budget_after_adjustment"
      },
      "message": "Plan needs more time than the member has: agree the time."
    },
    {
      "id": "always_ask",
      "when": {
        "always": true
      },
      "message": "Ask every member about mood, alcohol, falls (60+) and long-term sleep problems (see Pilot guide)."
    }
  ]
}